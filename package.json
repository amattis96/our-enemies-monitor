{
  "name": "our-enemies-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-based mapping of foreign interference, hybrid threats and strategic dependencies affecting Europe.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "astro dev --root web",
    "build": "astro build --root web && pagefind --site web/dist",
    "preview": "astro preview --root web",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm validate && pnpm validate:sidecars && pnpm validate:articles && pnpm validate:runs && pnpm validate:discovery && pnpm schemas --check && pnpm audit:m5 && pnpm check:contrast && pnpm check:roadmap && pnpm check:engine-manifest",
    "check:contrast": "node docs/design/scripts/check-contrast.mjs",
    "lint": "biome check --max-diagnostics=200 .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "node src/cli/validate.ts",
    "validate:sidecars": "node src/cli/validate-sidecars.ts",
    "validate:articles": "node src/cli/validate-articles.ts",
    "articles:hash": "node src/cli/articles-hash.ts",
    "format:data": "node src/cli/format-data.ts",
    "schemas": "node src/cli/schemas.ts",
    "import:baseline": "node src/cli/import-baseline.ts",
    "i18n:export": "node src/cli/i18n.ts export",
    "i18n:import": "node src/cli/i18n.ts import",
    "check:links": "node src/cli/check-links.ts",
    "data:diff": "node src/cli/data-diff.ts",
    "check:article-review": "node src/cli/check-article-review.ts",
    "check:pr": "node src/cli/pr-policy.ts",
    "audit:publication": "node src/cli/audit-publication.ts",
    "audit:m5": "node src/cli/audit-m5.ts",
    "benchmark:measure": "node src/cli/benchmark.ts measure",
    "benchmark:score": "node src/cli/benchmark.ts score",
    "cadence:measure": "node src/cli/cadence.ts",
    "audit:mentions": "node src/cli/mentions.ts",
    "ingest": "node src/cli/ingest.ts",
    "i18n:migrate-hashes": "node src/cli/migrate-translation-hashes.ts",
    "check:roadmap": "node src/cli/check-roadmap.ts",
    "render:roadmap": "node src/cli/render-roadmap.ts",
    "quality:report": "node src/cli/quality-report.ts",
    "audit:entities": "node src/cli/audit-entities.ts",
    "asof": "node src/cli/asof.ts",
    "snapshot": "node src/cli/snapshot.ts",
    "impact": "node src/cli/impact.ts",
    "check:missed-runs": "node src/cli/check-missed-runs.ts",
    "runs:record": "node src/cli/record-run.ts",
    "validate:runs": "node src/cli/validate-runs.ts",
    "validate:discovery": "node src/cli/validate-discovery.ts",
    "check:engine-manifest": "node src/cli/check-engine-manifest.ts",
    "check:seo": "node src/cli/check-seo.ts",
    "backtest": "node src/cli/backtest.ts",
    "brief": "node src/cli/generate-brief.ts",
    "discovery:shadow": "node src/cli/discovery-shadow.ts",
    "discovery:queue": "node src/cli/discovery-queue.ts",
    "check:i18n-budget": "node src/cli/check-i18n-budget.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.1.1",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "csv-parse": "7.0.3",
    "d3-force": "3.0.1",
    "d3-geo": "3.1.1",
    "d3-selection": "3.0.1",
    "d3-transition": "3.0.2",
    "d3-zoom": "3.0.1",
    "micromark": "4.0.3",
    "micromark-extension-gfm": "3.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.3",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/d3-force": "3.0.10",
    "@types/d3-geo": "3.1.1",
    "@types/d3-selection": "3.0.12",
    "@types/d3-transition": "3.0.9",
    "@types/d3-zoom": "3.0.9",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "fast-xml-parser": "5.11.2",
    "pagefind": "1.5.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}

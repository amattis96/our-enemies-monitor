{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claims.schema.json",
  "title": "claims",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^CL-\\d{4}$",
      "description": "Stable claim ID (CL-####); never renumbered or reused."
    },
    "case": {
      "type": "string",
      "pattern": "^CASE-\\d{4}$",
      "description": "Case the claim belongs to."
    },
    "kind": {
      "type": "string",
      "enum": [
        "fact",
        "attribution",
        "denial",
        "judgment"
      ],
      "description": "fact, attribution, denial or judgment: distinct claims, never merged. An attribution is not a judgment. Definitions: vocabulary.json#/claim_kinds."
    },
    "aspect": {
      "type": "string",
      "enum": [
        "occurrence",
        "perpetrator",
        "sponsor",
        "motive",
        "impact"
      ],
      "description": "What the claim is about: occurrence, perpetrator, sponsor, motive or impact, each a separate claim. Definitions: vocabulary.json#/claim_aspects."
    },
    "proposition": {
      "type": "object",
      "properties": {
        "it": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical Italian text. On divergence the Italian text prevails."
        },
        "en": {
          "description": "English translation; its status is in review.translations.en.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "it"
      ],
      "additionalProperties": false,
      "description": "The proposition, restating the cited record fields without adding precision or inference."
    },
    "limit": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "it": {
              "type": "string",
              "minLength": 1,
              "description": "Canonical Italian text. On divergence the Italian text prevails."
            },
            "en": {
              "description": "English translation; its status is in review.translations.en.",
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "it"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "What the claim does not establish (who established it, scope of the asserter, details resting on a single source); null when none."
    },
    "about": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^(TL-\\d{4}|EXT-\\d{3})$"
          },
          {
            "type": "string",
            "pattern": "^G-\\d{4}$"
          }
        ]
      },
      "description": "Events or relationships of the case the claim is about."
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "description": "Entities the proposition concerns; a person requires person_status."
    },
    "asserted_by": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            {
              "type": "string",
              "pattern": "^(TL-\\d{4}|EXT-\\d{3})$"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Entity that makes the claim (required for attribution and denial); null when the records do not name it."
    },
    "asserted_on": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        {
          "type": "null"
        }
      ],
      "description": "When the claim was made, with its real precision; null when the records do not state it. Distinct from the date of the fact."
    },
    "responds_to": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^CL-\\d{4}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Claim this one replies to (required for a denial); null otherwise."
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^CL-\\d{4}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Claim this one replaces; null when none."
    },
    "evidence_level": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "E1",
            "E2",
            "E3",
            "E4"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Kind of basis (E1-E4) of this specific claim, not a ranking (ADR-04); copied from a listed relationship, else null. Definitions: vocabulary.json#/evidence_levels."
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^G-\\d{4}$"
      },
      "description": "Existing relationships that carry the same statement (same about record, endpoint or event); empty when none. A person claim lists the relationship carrying the primary_url."
    },
    "transcribed_from": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(TL-\\d{4}|EXT-\\d{3})$"
              },
              {
                "type": "string",
                "pattern": "^G-\\d{4}$"
              },
              {
                "type": "string",
                "pattern": "^(S(?:\\d{2}|[1-9]\\d{2})|F\\d{2}|P\\d{2}|WEB|WEB-EXT-\\d{3})$"
              }
            ],
            "description": "Existing event, relationship or source record the claim is transcribed from."
          },
          "field": {
            "type": "string",
            "enum": [
              "title",
              "description",
              "evidence_note",
              "date",
              "predicate",
              "caveat"
            ],
            "description": "Field of that record whose content the claim restates; it must not be empty."
          }
        },
        "required": [
          "record",
          "field"
        ],
        "additionalProperties": false
      },
      "description": "Record fields the proposition is transcribed from."
    },
    "person_status": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "entity": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "description": "Person entity the claim concerns."
          },
          "status": {
            "type": "string",
            "enum": [
              "under_investigation",
              "charged",
              "convicted",
              "sentenced",
              "acquitted",
              "proceedings_closed"
            ],
            "description": "Exact legal or procedural status at status_date, not a ranking. Definitions: vocabulary.json#/procedural_statuses."
          },
          "status_date": {
            "type": "string",
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
            "description": "Date of that status with its real precision (YYYY, YYYY-MM or YYYY-MM-DD); never a publication date taken as the date of a conduct."
          },
          "primary_source": {
            "type": "string",
            "pattern": "^(S(?:\\d{2}|[1-9]\\d{2})|F\\d{2}|P\\d{2}|WEB|WEB-EXT-\\d{3})$",
            "description": "Specific primary source of the status: an external reference also cited by the claim."
          },
          "primary_url": {
            "type": "string",
            "format": "uri",
            "description": "URL of the primary source; must be registered on that source."
          },
          "note": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "it": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Canonical Italian text. On divergence the Italian text prevails."
                  },
                  "en": {
                    "description": "English translation; its status is in review.translations.en.",
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "it"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "Limits of the status (for example finality not recorded); null when none."
          }
        },
        "required": [
          "entity",
          "status",
          "status_date",
          "primary_source",
          "primary_url",
          "note"
        ],
        "additionalProperties": false
      },
      "description": "Procedural status of each person subject or asserter (AGENTS.md rule 7)."
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(S(?:\\d{2}|[1-9]\\d{2})|F\\d{2}|P\\d{2}|WEB|WEB-EXT-\\d{3})$"
      },
      "description": "Codes of cited sources (see sources.json). Corpus synthesis documents are not independent confirmations."
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "imported_unreviewed",
            "needs_review",
            "reviewed"
          ],
          "description": "Editorial review status of the record. imported_unreviewed is provisional, not verified. Definitions: vocabulary.json#/review_statuses."
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Free-text editorial and technical notes, in English; not typed claims."
        },
        "translations": {
          "description": "Translation state per language.",
          "type": "object",
          "properties": {
            "en": {
              "description": "State of the English translation.",
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "machine",
                    "reviewed"
                  ],
                  "description": "Translation status. Definitions: vocabulary.json#/translation_statuses."
                },
                "source_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$",
                  "description": "Fingerprint of the Italian texts the translation was made from."
                },
                "target_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$",
                  "description": "Fingerprint of the translated texts as imported."
                }
              },
              "required": [
                "status",
                "source_hash",
                "target_hash"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "notes"
      ],
      "additionalProperties": false,
      "description": "Editorial review state of the claim."
    },
    "provenance": {
      "maxItems": 0,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "format": "starts_with",
                "pattern": "^sources\\/.*",
                "description": "Original repository file under sources/."
              },
              "row": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "1-based data row of the original CSV file."
              },
              "original": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Verbatim original values of that row, keyed by column."
              }
            },
            "required": [
              "file",
              "row",
              "original"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "format": "starts_with",
                "pattern": "^sources\\/.*",
                "description": "Original repository file under sources/."
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "1-based line of the original text file."
              },
              "original": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Verbatim original line."
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false,
                "description": "Verbatim original text."
              }
            },
            "required": [
              "file",
              "line",
              "original"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "Always empty: cases and claims are editorial records, never imported."
    }
  },
  "required": [
    "id",
    "case",
    "kind",
    "aspect",
    "proposition",
    "limit",
    "about",
    "subjects",
    "asserted_by",
    "asserted_on",
    "responds_to",
    "supersedes",
    "evidence_level",
    "relationships",
    "transcribed_from",
    "person_status",
    "sources",
    "review",
    "provenance"
  ],
  "additionalProperties": false
}

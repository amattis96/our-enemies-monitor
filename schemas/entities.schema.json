{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "entities.schema.json",
  "title": "entities",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "description": "Stable local ID. A two-letter ID is not necessarily a country code: read kind and country."
    },
    "kind": {
      "type": "string",
      "enum": [
        "state",
        "institution",
        "person",
        "organization",
        "company",
        "asset"
      ],
      "description": "Kind of node. Definitions: vocabulary.json#/entity_kinds."
    },
    "name": {
      "type": "object",
      "properties": {
        "it": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical Italian text. On divergence the Italian text prevails."
        },
        "en": {
          "description": "English translation; its status is in review.translations.en.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "it"
      ],
      "additionalProperties": false,
      "description": "Display name."
    },
    "domain": {
      "type": "string",
      "enum": [
        "commerce-infrastructure",
        "dependencies",
        "geopolitics",
        "influence-technology",
        "institutional",
        "intelligence-security",
        "persons",
        "targets"
      ],
      "description": "Thematic domain from Fonte_07. Definitions: vocabulary.json#/entity_domains."
    },
    "country": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "ISO 3166-1 alpha-2 code of a state entity; null for every other kind."
    },
    "external_ids": {
      "description": "Qualified external identifiers (LEI, registry numbers, Wikidata QID, official website); absent when none.",
      "type": "object",
      "properties": {
        "lei": {
          "description": "ISO 17442 20-character Legal Entity Identifier (LEI).",
          "type": "string",
          "pattern": "^[0-9A-Z]{18}[0-9]{2}$"
        },
        "registry_numbers": {
          "description": "Qualified national/regional registration numbers with jurisdiction.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {
                "type": "string",
                "minLength": 1,
                "description": "Official registration number in the national register."
              },
              "jurisdiction": {
                "type": "string",
                "pattern": "^[A-Z]{2}$",
                "description": "ISO 3166-1 alpha-2 country code of the issuing jurisdiction."
              },
              "registry": {
                "description": "Name or code of the corporate/public registry.",
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "number",
              "jurisdiction"
            ],
            "additionalProperties": false
          }
        },
        "wikidata_qid": {
          "description": "Wikidata item identifier (e.g., Q12345).",
          "type": "string",
          "pattern": "^Q[1-9]\\d*$"
        },
        "official_website": {
          "description": "Official primary website URL.",
          "type": "string",
          "format": "uri"
        },
        "sanctions_ids": {
          "description": "External sanctions list identifiers (e.g., OpenSanctions, EU FSF, OFAC).",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "aliases": {
      "description": "Temporal aliases, historical names, and transliterations; absent when none.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Alias or historical name string."
          },
          "kind": {
            "type": "string",
            "enum": [
              "rename",
              "merger",
              "subsidiary",
              "transliteration"
            ],
            "description": "Kind of alias relationship (rename, merger, subsidiary, or transliteration)."
          },
          "valid_from": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Start date of validity (YYYY, YYYY-MM, or YYYY-MM-DD), or null if unknown."
          },
          "valid_to": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
              },
              {
                "type": "null"
              }
            ],
            "description": "End date of validity (YYYY, YYYY-MM, or YYYY-MM-DD), or null if ongoing or unknown."
          },
          "script": {
            "description": "Script of the alias (latin, cyrillic, or other).",
            "type": "string",
            "enum": [
              "latin",
              "cyrillic",
              "other"
            ]
          },
          "note": {
            "description": "Optional context or source note for the alias.",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "kind",
          "valid_from",
          "valid_to"
        ],
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "imported_unreviewed",
            "needs_review",
            "reviewed"
          ],
          "description": "Editorial review status of the record. imported_unreviewed is provisional, not verified. Definitions: vocabulary.json#/review_statuses."
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Free-text editorial and technical notes, in English; not typed claims."
        },
        "translations": {
          "description": "Translation state per language.",
          "type": "object",
          "properties": {
            "en": {
              "description": "State of the English translation.",
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "machine",
                    "reviewed"
                  ],
                  "description": "Translation status. Definitions: vocabulary.json#/translation_statuses."
                },
                "source_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$",
                  "description": "Fingerprint of the Italian texts the translation was made from."
                },
                "target_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$",
                  "description": "Fingerprint of the translated texts as imported."
                }
              },
              "required": [
                "status",
                "source_hash",
                "target_hash"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "notes"
      ],
      "additionalProperties": false,
      "description": "Editorial review state of the record."
    },
    "provenance": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "format": "starts_with",
                "pattern": "^sources\\/.*",
                "description": "Original repository file under sources/."
              },
              "row": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "1-based data row of the original CSV file."
              },
              "original": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Verbatim original values of that row, keyed by column."
              }
            },
            "required": [
              "file",
              "row",
              "original"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "format": "starts_with",
                "pattern": "^sources\\/.*",
                "description": "Original repository file under sources/."
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "1-based line of the original text file."
              },
              "original": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Verbatim original line."
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false,
                "description": "Verbatim original text."
              }
            },
            "required": [
              "file",
              "line",
              "original"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "Original corpus file and row or line each imported record derives from; empty for records created later."
    }
  },
  "required": [
    "id",
    "kind",
    "name",
    "domain",
    "country",
    "review",
    "provenance"
  ],
  "additionalProperties": false
}

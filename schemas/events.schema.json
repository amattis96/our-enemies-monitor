{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events.schema.json",
  "title": "events",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(TL-\\d{4}|EXT-\\d{3})$"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "event",
        "dataset_metadata"
      ]
    },
    "timeline_status": {
      "type": "string",
      "enum": [
        "integrated",
        "pending_integration"
      ]
    },
    "date": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        "end": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "precision": {
          "type": "string",
          "enum": [
            "year",
            "month",
            "day"
          ]
        }
      },
      "required": [
        "start",
        "end",
        "precision"
      ],
      "additionalProperties": false
    },
    "title": {
      "type": "object",
      "properties": {
        "it": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "it"
      ],
      "additionalProperties": false
    },
    "description": {
      "type": "object",
      "properties": {
        "it": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "it"
      ],
      "additionalProperties": false
    },
    "category": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "it": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "it"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "themes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "armed_conflict",
          "hybrid_sabotage",
          "cyber",
          "intelligence",
          "information_manipulation",
          "elections_influence",
          "finance_sanctions",
          "justice",
          "energy",
          "industry_dependencies",
          "infrastructure_space",
          "surveillance_spyware",
          "migration_borders",
          "geopolitics_diplomacy",
          "eu_nato_response",
          "society_health",
          "platforms_technology",
          "research_metadata"
        ]
      }
    },
    "geography": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "it": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "it"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "places": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      }
    },
    "evidence_note": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "it": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "it"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_level": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "E1",
            "E2",
            "E3",
            "E4",
            "E5"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "publisher": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(S\\d{2}|F\\d{2}|P\\d{2}|WEB|WEB-EXT-\\d{3})$"
      }
    },
    "known_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "misclassified_category",
              "date_reflects_publication"
            ]
          },
          "note": {
            "type": "object",
            "properties": {
              "it": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "it"
            ],
            "additionalProperties": false
          },
          "reported_in": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(S\\d{2}|F\\d{2}|P\\d{2}|WEB|WEB-EXT-\\d{3})$"
            }
          }
        },
        "required": [
          "code",
          "note",
          "reported_in"
        ],
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "imported_unreviewed",
            "needs_review",
            "reviewed"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "translations": {
          "type": "object",
          "properties": {
            "en": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "machine",
                    "reviewed"
                  ]
                },
                "source_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                }
              },
              "required": [
                "status",
                "source_hash"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "notes"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "format": "starts_with",
                "pattern": "^sources\\/.*"
              },
              "row": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "original": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "file",
              "row",
              "original"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "format": "starts_with",
                "pattern": "^sources\\/.*"
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "original": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "file",
              "line",
              "original"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "id",
    "record_type",
    "timeline_status",
    "date",
    "title",
    "description",
    "category",
    "themes",
    "geography",
    "places",
    "evidence_note",
    "evidence_level",
    "publisher",
    "url",
    "sources",
    "known_issues",
    "review",
    "provenance"
  ],
  "additionalProperties": false
}

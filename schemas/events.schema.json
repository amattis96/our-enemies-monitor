{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "events.schema.json",
  "title": "events",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(TL-\\d{4}|EXT-\\d{3})$",
      "description": "Stable record ID (TL-#### or EXT-###); never renumbered or reused."
    },
    "record_type": {
      "type": "string",
      "enum": [
        "event",
        "dataset_metadata"
      ],
      "description": "event, or dataset_metadata (a research collection date, not a geopolitical event). Definitions: vocabulary.json#/event_record_types."
    },
    "timeline_status": {
      "type": "string",
      "enum": [
        "integrated",
        "pending_integration"
      ],
      "description": "Whether the record is integrated in the timeline. Definitions: vocabulary.json#/timeline_statuses."
    },
    "date": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$",
          "description": "Start date: YYYY, YYYY-MM or YYYY-MM-DD (no invented precision)."
        },
        "end": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
            },
            {
              "type": "null"
            }
          ],
          "description": "End date with the same format, or null when unknown or none."
        },
        "precision": {
          "type": "string",
          "enum": [
            "year",
            "month",
            "day"
          ],
          "description": "Precision of the start date (year, month or day). Definitions: vocabulary.json#/date_precisions."
        }
      },
      "required": [
        "start",
        "end",
        "precision"
      ],
      "additionalProperties": false,
      "description": "Date of the fact with explicit precision; distinct from the date of its discovery, attribution, judgment or publication."
    },
    "title": {
      "type": "object",
      "properties": {
        "it": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical Italian text. On divergence the Italian text prevails."
        },
        "en": {
          "description": "English translation; its status is in review.translations.en.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "it"
      ],
      "additionalProperties": false,
      "description": "Short title."
    },
    "description": {
      "type": "object",
      "properties": {
        "it": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical Italian text. On divergence the Italian text prevails."
        },
        "en": {
          "description": "English translation; its status is in review.translations.en.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "it"
      ],
      "additionalProperties": false,
      "description": "Description of the record. Event, perpetrator, sponsor, motive and impact are distinct claims."
    },
    "category": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "it": {
              "type": "string",
              "minLength": 1,
              "description": "Canonical Italian text. On divergence the Italian text prevails."
            },
            "en": {
              "description": "English translation; its status is in review.translations.en.",
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "it"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "Original free-text category, the reference for themes; null when absent."
    },
    "themes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "armed_conflict",
          "hybrid_sabotage",
          "cyber",
          "intelligence",
          "information_manipulation",
          "elections_influence",
          "finance_sanctions",
          "justice",
          "energy",
          "industry_dependencies",
          "infrastructure_space",
          "surveillance_spyware",
          "migration_borders",
          "geopolitics_diplomacy",
          "eu_nato_response",
          "society_health",
          "platforms_technology",
          "research_metadata"
        ]
      },
      "description": "Editorial themes for filtering, assigned from the original category. Definitions: vocabulary.json#/themes."
    },
    "geography": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "it": {
              "type": "string",
              "minLength": 1,
              "description": "Canonical Italian text. On divergence the Italian text prevails."
            },
            "en": {
              "description": "English translation; its status is in review.translations.en.",
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "it"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "Original free-text geography, the reference for places; null when absent."
    },
    "places": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "description": "ISO 3166-1 alpha-2 codes of countries named by the geography; areas without a country stay out, no coordinates."
    },
    "evidence_note": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "it": {
              "type": "string",
              "minLength": 1,
              "description": "Canonical Italian text. On divergence the Italian text prevails."
            },
            "en": {
              "description": "English translation; its status is in review.translations.en.",
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "it"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "Original free-text evidence assessment of the record; null when absent."
    },
    "evidence_level": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "E1",
            "E2",
            "E3",
            "E4",
            "E5"
          ]
        },
        {
          "type": "null"
        }
      ],
      "description": "Evidence level when assigned, else null. Levels are kinds of basis, not a ranking. Definitions: vocabulary.json#/evidence_levels."
    },
    "publisher": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "Publisher of the reference document, as given by the corpus; null when absent."
    },
    "url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ],
      "description": "URL of the reference document; null when absent."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(S(?:\\d{2}|[1-9]\\d{2})|F\\d{2}|P\\d{2}|WEB|WEB-EXT-\\d{3})$"
      },
      "description": "Codes of cited sources (see sources.json). Corpus synthesis documents are not independent confirmations."
    },
    "known_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "misclassified_category",
              "date_reflects_publication"
            ],
            "description": "Kind of issue. Definitions: vocabulary.json#/known_issue_codes."
          },
          "note": {
            "type": "object",
            "properties": {
              "it": {
                "type": "string",
                "minLength": 1,
                "description": "Canonical Italian text. On divergence the Italian text prevails."
              },
              "en": {
                "description": "English translation; its status is in review.translations.en.",
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "it"
            ],
            "additionalProperties": false,
            "description": "What the corpus reports about the issue."
          },
          "reported_in": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(S(?:\\d{2}|[1-9]\\d{2})|F\\d{2}|P\\d{2}|WEB|WEB-EXT-\\d{3})$"
            },
            "description": "Sources that report the issue."
          }
        },
        "required": [
          "code",
          "note",
          "reported_in"
        ],
        "additionalProperties": false
      },
      "description": "Issues the corpus itself reports about this record."
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "imported_unreviewed",
            "needs_review",
            "reviewed"
          ],
          "description": "Editorial review status of the record. imported_unreviewed is provisional, not verified. Definitions: vocabulary.json#/review_statuses."
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Free-text editorial and technical notes, in English; not typed claims."
        },
        "translations": {
          "description": "Translation state per language.",
          "type": "object",
          "properties": {
            "en": {
              "description": "State of the English translation.",
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "machine",
                    "reviewed"
                  ],
                  "description": "Translation status. Definitions: vocabulary.json#/translation_statuses."
                },
                "source_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$",
                  "description": "Fingerprint of the Italian texts the translation was made from."
                },
                "target_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$",
                  "description": "Fingerprint of the translated texts as imported."
                }
              },
              "required": [
                "status",
                "source_hash",
                "target_hash"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "notes"
      ],
      "additionalProperties": false,
      "description": "Editorial review state of the record."
    },
    "provenance": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "format": "starts_with",
                "pattern": "^sources\\/.*",
                "description": "Original repository file under sources/."
              },
              "row": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "1-based data row of the original CSV file."
              },
              "original": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Verbatim original values of that row, keyed by column."
              }
            },
            "required": [
              "file",
              "row",
              "original"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "format": "starts_with",
                "pattern": "^sources\\/.*",
                "description": "Original repository file under sources/."
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "1-based line of the original text file."
              },
              "original": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Verbatim original line."
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false,
                "description": "Verbatim original text."
              }
            },
            "required": [
              "file",
              "line",
              "original"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "Original corpus file and row or line each imported record derives from; empty for records created later."
    }
  },
  "required": [
    "id",
    "record_type",
    "timeline_status",
    "date",
    "title",
    "description",
    "category",
    "themes",
    "geography",
    "places",
    "evidence_note",
    "evidence_level",
    "publisher",
    "url",
    "sources",
    "known_issues",
    "review",
    "provenance"
  ],
  "additionalProperties": false
}

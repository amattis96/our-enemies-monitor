{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exposures.schema.json",
  "title": "exposures",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^X-\\d{3}$",
      "description": "Stable record ID (X-###); not an entity ID."
    },
    "sector": {
      "type": "object",
      "properties": {
        "it": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical Italian text. On divergence the Italian text prevails."
        },
        "en": {
          "description": "English translation; its status is in review.translations.en.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "it"
      ],
      "additionalProperties": false,
      "description": "Sector concerned."
    },
    "indicator": {
      "type": "object",
      "properties": {
        "it": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical Italian text. On divergence the Italian text prevails."
        },
        "en": {
          "description": "English translation; its status is in review.translations.en.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "it"
      ],
      "additionalProperties": false,
      "description": "Original indicator text."
    },
    "measures": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "object",
            "properties": {
              "it": {
                "type": "string",
                "minLength": 1,
                "description": "Canonical Italian text. On divergence the Italian text prevails."
              },
              "en": {
                "description": "English translation; its status is in review.translations.en.",
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "it"
            ],
            "additionalProperties": false,
            "description": "What the value is."
          },
          "value": {
            "type": "number",
            "description": "Numeric value as given by the source."
          },
          "unit": {
            "type": "string",
            "enum": [
              "percent",
              "eur_billion",
              "count",
              "year"
            ],
            "description": "Unit. Definitions: vocabulary.json#/measure_units."
          },
          "qualifier": {
            "type": "string",
            "enum": [
              "exact",
              "approx",
              "more_than",
              "less_than",
              "nearly"
            ],
            "description": "How the source qualifies the value. Definitions: vocabulary.json#/measure_qualifiers."
          },
          "out_of": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ],
            "description": "Denominator for counts (\"19 of 20\") when the source gives one, else null."
          },
          "period": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}(-\\d{4})?$"
              },
              {
                "type": "null"
              }
            ],
            "description": "Reference period as stated by the source (2024, 2024-2026), else null."
          }
        },
        "required": [
          "label",
          "value",
          "unit",
          "qualifier",
          "out_of",
          "period"
        ],
        "additionalProperties": false
      },
      "description": "Quantified values; values from different universes are not comparable."
    },
    "scope": {
      "type": "object",
      "properties": {
        "it": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical Italian text. On divergence the Italian text prevails."
        },
        "en": {
          "description": "English translation; its status is in review.translations.en.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "it"
      ],
      "additionalProperties": false,
      "description": "What the value measures: denominator, universe, data series."
    },
    "consequence": {
      "type": "object",
      "properties": {
        "it": {
          "type": "string",
          "minLength": 1,
          "description": "Canonical Italian text. On divergence the Italian text prevails."
        },
        "en": {
          "description": "English translation; its status is in review.translations.en.",
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "it"
      ],
      "additionalProperties": false,
      "description": "Consequence stated by the source."
    },
    "status": {
      "type": "string",
      "enum": [
        "observed",
        "target"
      ],
      "description": "observed value or planned target. Definitions: vocabulary.json#/exposure_statuses."
    },
    "group": {
      "description": "Editorial grouping of exposures: a supply chain or a before/after comparison. Adds no value, period or causal link. Absent when the exposure belongs to no group.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "rare_earth_magnets",
            "eu_gas"
          ],
          "description": "Editorial group. Definitions and kind: vocabulary.json#/exposure_groups."
        },
        "position": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Order within the group: stage in a supply chain (1 = upstream) or display order in a before/after group. An editorial sequence, not a measure."
        }
      },
      "required": [
        "id",
        "position"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(S(?:\\d{2}|[1-9]\\d{2})|F\\d{2}|P\\d{2}|WEB|WEB-EXT-\\d{3})$"
      },
      "description": "Codes of cited sources (see sources.json). Corpus synthesis documents are not independent confirmations."
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "imported_unreviewed",
            "needs_review",
            "reviewed"
          ],
          "description": "Editorial review status of the record. imported_unreviewed is provisional, not verified. Definitions: vocabulary.json#/review_statuses."
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Free-text editorial and technical notes, in English; not typed claims."
        },
        "translations": {
          "description": "Translation state per language.",
          "type": "object",
          "properties": {
            "en": {
              "description": "State of the English translation.",
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "machine",
                    "reviewed"
                  ],
                  "description": "Translation status. Definitions: vocabulary.json#/translation_statuses."
                },
                "source_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$",
                  "description": "Fingerprint of the Italian texts the translation was made from."
                },
                "target_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$",
                  "description": "Fingerprint of the translated texts as imported."
                }
              },
              "required": [
                "status",
                "source_hash",
                "target_hash"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "notes"
      ],
      "additionalProperties": false,
      "description": "Editorial review state of the record."
    },
    "provenance": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "format": "starts_with",
                "pattern": "^sources\\/.*",
                "description": "Original repository file under sources/."
              },
              "row": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "1-based data row of the original CSV file."
              },
              "original": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Verbatim original values of that row, keyed by column."
              }
            },
            "required": [
              "file",
              "row",
              "original"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "format": "starts_with",
                "pattern": "^sources\\/.*",
                "description": "Original repository file under sources/."
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "1-based line of the original text file."
              },
              "original": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Verbatim original line."
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false,
                "description": "Verbatim original text."
              }
            },
            "required": [
              "file",
              "line",
              "original"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "Original corpus file and row or line each imported record derives from; empty for records created later."
    }
  },
  "required": [
    "id",
    "sector",
    "indicator",
    "measures",
    "scope",
    "consequence",
    "status",
    "sources",
    "review",
    "provenance"
  ],
  "additionalProperties": false
}

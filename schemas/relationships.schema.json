{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relationships.schema.json",
  "title": "relationships",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^G-\\d{4}$"
    },
    "subject": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        {
          "type": "string",
          "pattern": "^(TL-\\d{4}|EXT-\\d{3})$"
        }
      ]
    },
    "predicate": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "object": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        {
          "type": "string",
          "pattern": "^(TL-\\d{4}|EXT-\\d{3})$"
        }
      ]
    },
    "relation_class": {
      "type": "string",
      "enum": [
        "event_participation",
        "operational",
        "ownership",
        "governance",
        "financial",
        "influence",
        "information",
        "information_flow",
        "platform",
        "political",
        "intelligence",
        "technical",
        "security",
        "surveillance",
        "military",
        "hybrid",
        "supply",
        "dependency",
        "infrastructure",
        "technology",
        "trade",
        "commerce",
        "commercial",
        "competition",
        "policy",
        "legal",
        "diplomacy",
        "oversight",
        "context",
        "consequence"
      ]
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "E1",
        "E2",
        "E3",
        "E4"
      ]
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "documented",
        "corroborated",
        "institutional_attribution",
        "allegation"
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(TL-\\d{4}|EXT-\\d{3})$"
      }
    },
    "valid_from": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_to": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "primary_url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ]
    },
    "caveat": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "it": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "it"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(S\\d{2}|F\\d{2}|P\\d{2}|WEB|WEB-EXT-\\d{3})$"
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "imported_unreviewed",
            "needs_review",
            "reviewed"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "status",
        "notes"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "format": "starts_with",
                "pattern": "^sources\\/.*"
              },
              "row": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "original": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "file",
              "row",
              "original"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "format": "starts_with",
                "pattern": "^sources\\/.*"
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "original": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "file",
              "line",
              "original"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "id",
    "subject",
    "predicate",
    "object",
    "relation_class",
    "evidence_level",
    "evidence_status",
    "events",
    "valid_from",
    "valid_to",
    "primary_url",
    "caveat",
    "sources",
    "review",
    "provenance"
  ],
  "additionalProperties": false
}

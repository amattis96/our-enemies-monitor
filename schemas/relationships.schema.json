{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "relationships.schema.json",
  "title": "relationships",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^G-\\d{4}$",
      "description": "Stable record ID (G-####); never renumbered or reused."
    },
    "subject": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        {
          "type": "string",
          "pattern": "^(TL-\\d{4}|EXT-\\d{3})$"
        }
      ],
      "description": "Entity or event ID the statement is about."
    },
    "predicate": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$",
      "description": "Original predicate, to be read literally (Italian or English as in the corpus); never translated."
    },
    "object": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        {
          "type": "string",
          "pattern": "^(TL-\\d{4}|EXT-\\d{3})$"
        }
      ],
      "description": "Entity or event ID the subject is related to."
    },
    "relation_class": {
      "type": "string",
      "enum": [
        "event_participation",
        "operational",
        "ownership",
        "governance",
        "financial",
        "influence",
        "information",
        "information_flow",
        "platform",
        "political",
        "intelligence",
        "technical",
        "security",
        "surveillance",
        "military",
        "hybrid",
        "supply",
        "dependency",
        "infrastructure",
        "technology",
        "trade",
        "commerce",
        "commercial",
        "competition",
        "policy",
        "legal",
        "diplomacy",
        "oversight",
        "context",
        "consequence"
      ],
      "description": "Original class from Fonte_07. Participation is presence or role, not control, financing or coordination. Definitions: vocabulary.json#/relation_classes."
    },
    "evidence_level": {
      "type": "string",
      "enum": [
        "E1",
        "E2",
        "E3",
        "E4"
      ],
      "description": "Evidence level (E1-E4) of this statement. Kinds of basis, not a ranking: E2 is not stronger or weaker than E3; E2 is an attribution, not a conviction. Definitions: vocabulary.json#/evidence_levels."
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "documented",
        "corroborated",
        "institutional_attribution",
        "allegation"
      ],
      "description": "Original Fonte_07 evidence code; it pairs one-to-one with evidence_level and is not an independent assessment. Definitions: vocabulary.json#/evidence_statuses."
    },
    "events": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(TL-\\d{4}|EXT-\\d{3})$"
      },
      "description": "Events this relationship was recorded in."
    },
    "valid_from": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Start of validity when stated by a source; null when unknown."
    },
    "valid_to": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
        },
        {
          "type": "null"
        }
      ],
      "description": "End of validity when stated by a source; null when unknown or ongoing."
    },
    "primary_url": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri"
        },
        {
          "type": "null"
        }
      ],
      "description": "URL of the primary document supporting the statement; null when not linked."
    },
    "caveat": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "it": {
              "type": "string",
              "minLength": 1,
              "description": "Canonical Italian text. On divergence the Italian text prevails."
            },
            "en": {
              "description": "English translation; its status is in review.translations.en.",
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "it"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ],
      "description": "Limits of the statement; a caveat that negates an inference must be kept with the relationship."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(S(?:\\d{2}|[1-9]\\d{2})|F\\d{2}|P\\d{2}|WEB|WEB-EXT-\\d{3})$"
      },
      "description": "Codes of cited sources (see sources.json). Corpus synthesis documents are not independent confirmations."
    },
    "review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "imported_unreviewed",
            "needs_review",
            "reviewed"
          ],
          "description": "Editorial review status of the record. imported_unreviewed is provisional, not verified. Definitions: vocabulary.json#/review_statuses."
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Free-text editorial and technical notes, in English; not typed claims."
        },
        "translations": {
          "description": "Translation state per language.",
          "type": "object",
          "properties": {
            "en": {
              "description": "State of the English translation.",
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "machine",
                    "reviewed"
                  ],
                  "description": "Translation status. Definitions: vocabulary.json#/translation_statuses."
                },
                "source_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$",
                  "description": "Fingerprint of the Italian texts the translation was made from."
                },
                "target_hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$",
                  "description": "Fingerprint of the translated texts as imported."
                }
              },
              "required": [
                "status",
                "source_hash",
                "target_hash"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "status",
        "notes"
      ],
      "additionalProperties": false,
      "description": "Editorial review state of the record."
    },
    "provenance": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "format": "starts_with",
                "pattern": "^sources\\/.*",
                "description": "Original repository file under sources/."
              },
              "row": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "1-based data row of the original CSV file."
              },
              "original": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Verbatim original values of that row, keyed by column."
              }
            },
            "required": [
              "file",
              "row",
              "original"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "format": "starts_with",
                "pattern": "^sources\\/.*",
                "description": "Original repository file under sources/."
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "description": "1-based line of the original text file."
              },
              "original": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "Verbatim original line."
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false,
                "description": "Verbatim original text."
              }
            },
            "required": [
              "file",
              "line",
              "original"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "Original corpus file and row or line each imported record derives from; empty for records created later."
    }
  },
  "required": [
    "id",
    "subject",
    "predicate",
    "object",
    "relation_class",
    "evidence_level",
    "evidence_status",
    "events",
    "valid_from",
    "valid_to",
    "primary_url",
    "caveat",
    "sources",
    "review",
    "provenance"
  ],
  "additionalProperties": false
}

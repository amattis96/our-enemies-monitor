<node id="EV_TL-0001">
  <data key="d0">Attacchi DDoS contro l’Estonia</data>
  <data key="d1">event</data>
  <data key="d2">Cyber / sicurezza</data>
  <data key="d3">Estonia</data>
  <data key="d4">2007-04</data>
  <data key="d5">2007-05</data>
  <data key="d6">month</data>
  <data key="d7">S06,S00;S03;S05</data>
  <data key="d8">Evento accertato; mandante statale contestato</data>
  <data key="d9">Record originale TL-0001; Dopo la crisi del Bronze Soldier vengono colpiti governo, banche e media; il comando diretto dello Stato russo non è conclusivamente provato.</data>
</node>
<node id="EV_TL-0002">
  <data key="d0">Cyberattacchi durante la guerra russo-georgiana</data>
  <data key="d1">event</data>
  <data key="d2">Cyber / guerra</data>
  <data key="d3">Georgia</data>
  <data key="d4">2008-08</data>
  <data key="d5"></data>
  <data key="d6">month</data>
  <data key="d7">S06,S03</data>
  <data key="d8">Evento corroborato; regia cyber non conclusiva</data>
  <data key="d9">Record originale TL-0002; DDoS e compromissioni di siti accompagnano l’offensiva militare russa; catena di comando cyber statale incompleta nelle fonti aperte.</data>
</node>
<node id="EV_TL-0003">
  <data key="d0">Hapsburg Group e lobbying per Yanukovych</data>
  <data key="d1">event</data>
  <data key="d2">Influenza politica</data>
  <data key="d3">Europa / Ucraina</data>
  <data key="d4">2012</data>
  <data key="d5">2014</data>
  <data key="d6">year</data>
  <data key="d7">S06,S01</data>
  <data key="d8">Documentato in atti giudiziari; regia russa non provata</data>
  <data key="d9">Record originale TL-0003; Manafort/Gates organizzano una rete di ex personalità politiche europee per attività favorevoli al governo Yanukovych e al Party of Regions. Non dimostrata una catena diretta del Cremlino.</data>
</node>
<node id="EV_TL-0004">
  <data key="d0">Avvio e ampliamento del regime sanzionatorio UE sulla Russia</data>
  <data key="d1">event</data>
  <data key="d2">Sanzioni / diplomazia</data>
  <data key="d3">Unione europea</data>
  <data key="d4">2014</data>

<node id="EV_TL-0009">
  <data key="d0">Interferenza russa nelle presidenziali statunitensi</data>
  <data key="d1">event</data>
  <data key="d2">Interferenza elettorale</data>
  <data key="d3">Stati Uniti</data>
  <data key="d4">2016</data>
  <data key="d5"></data>
  <data key="d6">year</data>
  <data key="d7">S06,S00;S05</data>
  <data key="d8">Attribuzione istituzionale; impatto ignoto</data>
  <data key="d9">Record originale TL-0009; Intelligence e successivi rapporti del Senato USA documentano operazioni russe; non quantificano la variazione del voto né stabiliscono una cospirazione generale Trump-Russia.</data>
</node>
<node id="EV_TL-0010">
  <data key="d0">Referendum Brexit e operazioni informative</data>
  <data key="d1">event</data>

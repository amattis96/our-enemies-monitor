  <data key="d6">year</data>
  <data key="d7">S06,S00;S05</data>
  <data key="d8">Atto istituzionale</data>
  <data key="d9">Record originale TL-0004; L’UE costruisce le misure restrittive in risposta alla violazione della sovranità ucraina.</data>
</node>
<node id="EV_TL-0005">
  <data key="d0">Inizio della guerra nel Donbas</data>
  <data key="d1">event</data>
  <data key="d2">Guerra</data>
  <data key="d3">Ucraina</data>
  <data key="d4">2014</data>
  <data key="d5"></data>
  <data key="d6">year</data>
  <data key="d7">S06,S00;S03;S05</data>
  <data key="d8">Accertato</data>
  <data key="d9">Record originale TL-0005; Conflitto armato nell’Ucraina orientale nel contesto dell’aggressione russa; punto di svolta per la sicurezza europea.</data>
</node>
<node id="EV_TL-0006">
  <data key="d0">Occupazione e annessione illegale della Crimea</data>
  <data key="d1">event</data>
  <data key="d2">Guerra</data>

  <data key="d9">Record originale TL-0006; La Russia occupa e annette la penisola ucraina, in violazione del diritto internazionale.</data>
</node>
<node id="EV_TL-0007">
  <data key="d0">Esplosioni nei depositi di Vrbětice</data>
  <data key="d1">event</data>
  <data key="d2">Sabotaggio</data>

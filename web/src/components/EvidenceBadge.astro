---
import {
  EVIDENCE_LEVEL_LABELS,
  type EvidenceLevel,
  type Language,
} from "../../../src/model/index.ts";

interface Props {
  level: EvidenceLevel;
  lang: Language;
}
const { level, lang } = Astro.props;
const label = EVIDENCE_LEVEL_LABELS[level][lang];
---

<span class="badge font-mono" title={label}>
  {level}<span class="sr-only">: {label}</span>
</span>

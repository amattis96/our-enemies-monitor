---
import {
  EVIDENCE_LEVEL_LABELS,
  type EvidenceLevel,
  type Language,
} from "../../../src/model/index.ts";
import { evidencePlainDefinition } from "../../../src/site/glossary.ts";
import { EVIDENCE_ICON, evidenceShort } from "../../../src/site/visual.ts";
import Icon from "./Icon.astro";

// Evidence stamp: glyph (shape) + code + short label + plain-language definition. Never colour alone.
interface Props {
  level: EvidenceLevel;
  lang: Language;
  /** compact: glyph + code (tables); default adds the short label. Both show the plain-language definition. */
  variant?: "compact" | "default";
}
const { level, lang, variant = "default" } = Astro.props;
const definition = EVIDENCE_LEVEL_LABELS[level][lang];
const plain = evidencePlainDefinition(level, lang);
---

<span class="evidence-stamp">
  <span class="stamp" data-level={level} title={`${level}: ${definition}`}>
    <Icon name={EVIDENCE_ICON[level]} />
    {level}
    {variant === "default" ? <small>{evidenceShort(level, lang)}</small> : <span class="sr-only">{evidenceShort(level, lang)}</span>}
  </span>
  <span class="stamp-def">{plain}</span>
</span>

<style>
  .evidence-stamp {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35em 0.5em;
  }
  .stamp-def {
    font: 400 var(--text-xs) / 1.35 var(--font-sans);
    color: var(--ink-2);
    white-space: normal;
  }
</style>

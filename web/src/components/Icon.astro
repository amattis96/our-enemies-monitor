---
import { assetHref } from "../lib/links.ts";

// Icon from the Dossier sprite (docs/design/assets/icons.svg). Decorative by
// default; pass `label` when the icon stands alone and must be announced.
interface Props {
  name: string;
  label?: string;
  class?: string;
}
const { name, label, class: className } = Astro.props;
---

<svg
  class:list={["icon", className]}
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
  focusable="false"><use href={`${assetHref("icons.svg")}#${name}`} /></svg>

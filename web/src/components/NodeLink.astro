---
import type { Language } from "../../../src/model/index.ts";
import { textOf } from "../../../src/site/i18n.ts";
import { KIND_ICON } from "../../../src/site/visual.ts";
import { href, nodeHref } from "../lib/links.ts";
import { getModel } from "../lib/model.ts";
import Icon from "./Icon.astro";
import T from "./T.astro";

interface Props {
  id: string;
  lang: Language;
  icon?: boolean;
}
const { id, lang, icon = true } = Astro.props;
const model = getModel();
const nodeKind = model.nodeKind(id);
const hypothesis = !nodeKind ? model.hypothesis(id) : undefined;
const source = !nodeKind && !hypothesis ? model.source(id) : undefined;

const kind = nodeKind ?? "event";
const targetHref = nodeKind
  ? nodeHref(id, nodeKind, lang)
  : hypothesis
    ? href(`hypotheses/${id}/`, lang)
    : source
      ? href(`sources/${id}/`, lang)
      : nodeHref(id, undefined, lang);

const localizedName = nodeKind
  ? model.nodeName(id)
  : hypothesis
    ? hypothesis.question
    : source
      ? source.title
      : { it: id };

const visibleLabel = textOf(localizedName, lang);
const tooltip = visibleLabel !== id ? `${visibleLabel} (${id})` : id;
---

<a class="node-link" href={targetHref} title={tooltip} data-code={id}>{icon && <Icon name={KIND_ICON[kind]} class="node-icon" />}<T text={localizedName} lang={lang} /></a>

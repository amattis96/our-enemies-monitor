---
import type { Language, Relationship } from "../../../src/model/index.ts";
import {
  EVIDENCE_STATUS_LABELS,
  formatPredicate,
  RELATION_GROUP_LABELS,
} from "../../../src/site/format.ts";
import { ui } from "../../../src/site/i18n.ts";
import { relationGroup } from "../../../src/site/read-model.ts";
import { RELATION_GROUP_COLOR, RELATION_GROUP_ICON } from "../../../src/site/visual.ts";
import { getModel } from "../lib/model.ts";
import EvidenceStamp from "./EvidenceStamp.astro";
import Icon from "./Icon.astro";
import NodeLink from "./NodeLink.astro";
import SourceRefs from "./SourceRefs.astro";
import StatusLabel from "./StatusLabel.astro";
import T from "./T.astro";

interface Props {
  relationships: Relationship[];
  caption: string;
  lang: Language;
}
const { relationships, caption, lang } = Astro.props;
const model = getModel();
const t = ui(lang);
---

<div class="table-wrap">
  <table class="stack">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        <th scope="col">{t.subject}</th>
        <th scope="col">{t.relationship}</th>
        <th scope="col">{t.object}</th>
        <th scope="col">{t.evidence}</th>
        <th scope="col">{t.sources}</th>
      </tr>
    </thead>
    <tbody>
      {
        relationships.map((r) => {
          const group = relationGroup(r);
          return model.isRestricted(r) ? (
            <tr>
              <td data-label={t.subject}><NodeLink id={r.subject} lang={lang} /></td>
              <td colspan="2" data-label={t.relationship}>
                <span class="mono text-xs">{r.id}</span>{" "}
                <StatusLabel icon="st-restricted">{t.restricted}</StatusLabel>
              </td>
              <td data-label={t.evidence}><EvidenceStamp level={r.evidence_level} lang={lang} variant="compact" /></td>
              <td data-label={t.sources}><SourceRefs ids={r.sources} lang={lang} /></td>
            </tr>
          ) : (
            <tr>
              <td data-label={t.subject}><NodeLink id={r.subject} lang={lang} /></td>
              <td data-label={t.relationship}>
                <div class="rel-cell">
                  <span>
                    <span class="mono text-xs text-muted">{r.id}</span>{" "}
                    <span class="rel-predicate" lang="it">{formatPredicate(r.predicate)}</span>
                  </span>
                  <span class="rel-group">
                    <span class="dot" style={`background:${RELATION_GROUP_COLOR[group]}`} />
                    <Icon name={RELATION_GROUP_ICON[group]} />
                    {RELATION_GROUP_LABELS[group][lang]} · {EVIDENCE_STATUS_LABELS[r.evidence_status][lang]}
                  </span>
                  {r.caveat && <span class="meta italic"><T text={r.caveat} lang={lang} /></span>}
                  {r.primary_url && (
                    <a class="meta" href={r.primary_url} rel="noopener"><Icon name="st-primary" /> {t.primarySource}</a>
                  )}
                </div>
              </td>
              <td data-label={t.object}><NodeLink id={r.object} lang={lang} /></td>
              <td data-label={t.evidence}><EvidenceStamp level={r.evidence_level} lang={lang} variant="compact" /></td>
              <td data-label={t.sources}><SourceRefs ids={r.sources} lang={lang} /></td>
            </tr>
          );
        })
      }
    </tbody>
  </table>
</div>

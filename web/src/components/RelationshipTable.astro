---
import type { Relationship } from "../../../src/model/index.ts";
import {
  EVIDENCE_STATUS_LABELS,
  formatPredicate,
  RELATION_GROUP_LABELS,
} from "../../../src/site/format.ts";
import { relationGroup } from "../../../src/site/read-model.ts";
import { getModel } from "../lib/model.ts";
import EvidenceBadge from "./EvidenceBadge.astro";
import NodeLink from "./NodeLink.astro";
import SourceRefs from "./SourceRefs.astro";

interface Props {
  relationships: Relationship[];
  caption: string;
}
const { relationships, caption } = Astro.props;
const model = getModel();
---

<table>
  <caption class="sr-only">{caption}</caption>
  <thead>
    <tr>
      <th scope="col">Soggetto</th>
      <th scope="col">Relazione (predicato letterale)</th>
      <th scope="col">Oggetto</th>
      <th scope="col">Evidenza</th>
      <th scope="col">Fonti</th>
    </tr>
  </thead>
  <tbody>
    {
      relationships.map((r) =>
        model.isRestricted(r) ? (
          <tr>
            <td><NodeLink id={r.subject} /></td>
            <td colspan="2">
              <span class="meta">
                Relazione riservata ({r.id}): riguarda una persona e non ha ancora una fonte primaria
                collegata. Sarà pubblicata dopo la revisione editoriale.
              </span>
            </td>
            <td><EvidenceBadge level={r.evidence_level} /></td>
            <td><SourceRefs ids={r.sources} /></td>
          </tr>
        ) : (
          <tr>
            <td><NodeLink id={r.subject} /></td>
            <td>
              <span class="font-mono text-xs">{r.id}</span> {formatPredicate(r.predicate)}
              <div class="meta">
                {RELATION_GROUP_LABELS[relationGroup(r)]} · {r.relation_class} ·{" "}
                {EVIDENCE_STATUS_LABELS[r.evidence_status]}
              </div>
              {r.caveat && <div class="meta italic">{r.caveat.it}</div>}
              {r.primary_url && (
                <div class="meta">
                  <a href={r.primary_url} rel="noopener">Fonte primaria</a>
                </div>
              )}
            </td>
            <td><NodeLink id={r.object} /></td>
            <td><EvidenceBadge level={r.evidence_level} /></td>
            <td><SourceRefs ids={r.sources} /></td>
          </tr>
        ),
      )
    }
  </tbody>
</table>

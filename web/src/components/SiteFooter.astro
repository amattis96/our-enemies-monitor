---
import type { Language } from "../../../src/model/index.ts";
import { choose, ui } from "../../../src/site/i18n.ts";
import { inlineSvg } from "../lib/design.ts";
import { href } from "../lib/links.ts";

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const t = ui(lang);
const c = (it: string, en: string) => choose(lang, it, en);
const repo = "https://github.com/amattis96/our-enemies-monitor";

/** Secondary/reference links only — primary sections live in SiteHeader. */
const referenceLinks = [
  ["methodology/", t.navMethodology],
  ["glossario/", c("Glossario", "Glossary")],
  ["hypotheses/", t.navHypotheses],
  ["sources/", t.navSources],
  ["data/", t.navData],
  ["changes/", t.navChanges],
  ["search/", t.navSearch],
] as const;

/** New observatory sections (engine plan M10–M12): reachable from every page. */
const observatoryLinks = [
  ["inizia-qui/", c("Inizia qui", "Start here")],
  ["laboratorio/", c("Laboratorio", "Laboratory")],
  ["situazione/", c("Sala situazione", "Situation room")],
  ["brief/", c("Brief", "Briefs")],
  ["affidabilita/", c("Affidabilità delle fonti", "Source reliability")],
  ["metodo/motore/", c("Trasparenza del motore", "Engine transparency")],
  ["stato/", c("Stato delle esecuzioni", "Run status")],
  ["rettifiche/", c("Rettifiche e replica", "Corrections and reply")],
  ["api/", c("API e citazione", "API and citation")],
] as const;
---

<footer class="site-footer" data-pagefind-ignore>
  <div class="site-footer-inner">
    <div class="footer-brand">
      <a class="brand" href={href("", lang)}>
        <span class="brand-mark" set:html={inlineSvg("logo-mark.svg", "ftr")} />
        <span class="brand-name">Our Enemies Monitor</span>
      </a>
      <p>{t.footerDisclaimer}</p>
      <p class="meta">
        {t.footerCode} <a href={`${repo}/blob/main/LICENSE`}>MIT</a> · {t.footerData}{" "}
        <a href={`${repo}/blob/main/LICENSE-DATA.md`}>CC0 1.0</a> · <a href={repo}>{t.footerSource}</a>
      </p>
    </div>
    <nav aria-label={c("Osservatorio", "Observatory")}>
      <p class="kicker">{c("Osservatorio", "Observatory")}</p>
      <ul>
        {observatoryLinks.map(([path, label]) => (
          <li>
            <a href={href(path, lang)}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <nav aria-label={t.footerMethod}>
      <p class="kicker">{t.footerMethod}</p>
      <ul>
        {referenceLinks.map(([path, label]) => (
          <li>
            <a href={href(path, lang)}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

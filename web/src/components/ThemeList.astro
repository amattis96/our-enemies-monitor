---
import { type Language, THEME_LABELS, type Theme } from "../../../src/model/index.ts";
import { THEME_ICON } from "../../../src/site/visual.ts";
import { href } from "../lib/links.ts";
import Icon from "./Icon.astro";

interface Props {
  themes: Theme[];
  lang: Language;
}
const { themes, lang } = Astro.props;
---

<span class="inline-flex flex-wrap gap-1.5">
  {
    themes.map((theme) => (
      <a class="chip" href={href(`timeline/?tema=${theme}`, lang)}>
        <Icon name={THEME_ICON(theme)} />
        {THEME_LABELS[theme][lang]}
      </a>
    ))
  }
</span>

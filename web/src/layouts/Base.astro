---
import "../styles/global.css";
import type { Language } from "../../../src/model/index.ts";
import { ui } from "../../../src/site/i18n.ts";
import { alternatePath, assetHref, href } from "../lib/links.ts";

interface Props {
  title: string;
  lang: Language;
  description?: string;
  /** Index the page in the site search. */
  searchable?: boolean;
  /** Whether the page exists in the other language (false for the 404 page). */
  translated?: boolean;
}

const { title, lang, description, searchable = false, translated = true } = Astro.props;
const t = ui(lang);
const other: Language = lang === "it" ? "en" : "it";
const fullTitle = title === "Our Enemies Monitor" ? title : `${title} · Our Enemies Monitor`;
const nav = [
  ["timeline/", t.navTimeline],
  ["network/", t.navNetwork],
  ["atlas/", t.navAtlas],
  ["dependencies/", t.navDependencies],
  ["entities/", t.navEntities],
  ["hypotheses/", t.navHypotheses],
  ["sources/", t.navSources],
  ["methodology/", t.navMethodology],
  ["data/", t.navData],
  ["search/", t.navSearch],
] as const;
const current = Astro.url.pathname;
const site = Astro.site?.origin ?? "";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={assetHref("favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={assetHref("sitemap-index.xml")} />
    {
      translated && (
        <>
          <link rel="alternate" hreflang="it" href={`${site}${alternatePath(current, "it")}`} />
          <link rel="alternate" hreflang="en" href={`${site}${alternatePath(current, "en")}`} />
        </>
      )
    }
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:p-2 focus:bg-white">
      {t.skipToContent}
    </a>
    <header class="border-b border-line bg-wash">
      <div class="mx-auto max-w-6xl px-4 py-3 flex flex-wrap items-baseline gap-x-6 gap-y-2">
        <a href={href("", lang)} class="font-bold no-underline text-ink">Our Enemies Monitor</a>
        <nav aria-label={t.mainNav} class="flex-1">
          <ul class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
            {
              nav.map(([path, label]) => {
                const target = href(path, lang);
                const active = current.startsWith(target);
                return (
                  <li>
                    <a
                      href={target}
                      aria-current={active ? "page" : undefined}
                      class:list={[active && "font-semibold"]}
                    >
                      {label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
        {translated && <a
          href={alternatePath(current, other)}
          hreflang={other}
          lang={other}
          aria-label={t.switchLanguageLabel}
          class="text-sm"
        >
          {t.switchLanguage}
        </a>}
      </div>
    </header>
    <main
      id="main"
      class="mx-auto w-full min-w-0 max-w-6xl px-4 py-6 flex-1"
      data-pagefind-body={searchable ? "" : undefined}
    >
      <slot />
    </main>
    <footer class="border-t border-line bg-wash" data-pagefind-ignore>
      <div class="mx-auto max-w-6xl px-4 py-4 meta space-y-1">
        <p>{t.footerDisclaimer}</p>
        <p>
          {t.footerCode}{" "}
          <a href="https://github.com/amattis96/our-enemies-monitor/blob/main/LICENSE">MIT</a>{" "}
          · {t.footerData}{" "}
          <a href="https://github.com/amattis96/our-enemies-monitor/blob/main/LICENSE-DATA.md"
            >CC0 1.0</a
          >{" "}
          · <a href="https://github.com/amattis96/our-enemies-monitor">{t.footerSource}</a>
        </p>
      </div>
    </footer>
  </body>
</html>

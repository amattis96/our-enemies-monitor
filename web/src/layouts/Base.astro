---
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource-variable/ibm-plex-sans/wght.css";
import "@fontsource-variable/ibm-plex-sans/wght-italic.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../styles/global.css";
import "../styles/shell.css";
import type { Language } from "../../../src/model/index.ts";
import { ui } from "../../../src/site/i18n.ts";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { alternatePath, assetHref } from "../lib/links.ts";

interface Props {
  title: string;
  lang: Language;
  description?: string;
  /** Index the page in the site search. */
  searchable?: boolean;
  /** Whether the page exists in the other language (false for the 404 page). */
  translated?: boolean;
  /** Console views (timeline, board, atlas) use the wide page. */
  wide?: boolean;
}

const {
  title,
  lang,
  description,
  searchable = false,
  translated = true,
  wide = false,
} = Astro.props;
const t = ui(lang);
const fullTitle = title === "Our Enemies Monitor" ? title : `${title} · Our Enemies Monitor`;
const current = Astro.url.pathname;
const site = Astro.site?.origin ?? "";
const pageDescription = description ?? t.siteTagline;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f4ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f1217" media="(prefers-color-scheme: dark)" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Our Enemies Monitor" />
    <meta property="og:locale" content={lang === "it" ? "it_IT" : "en_GB"} />
    <link rel="icon" href={assetHref("favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={assetHref("sitemap-index.xml")} />
    {
      translated && (
        <>
          <link rel="alternate" hreflang="it" href={`${site}${alternatePath(current, "it")}`} />
          <link rel="alternate" hreflang="en" href={`${site}${alternatePath(current, "en")}`} />
        </>
      )
    }
    <script is:inline>
      // Theme before first paint: stored choice, else the system preference.
      try {
        const theme = localStorage.getItem("oem-theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{t.skipToContent}</a>
    <SiteHeader lang={lang} translated={translated} />
    <slot name="masthead" />
    <main
      id="main"
      class:list={["page", wide && "page-wide"]}
      data-pagefind-body={searchable ? "" : undefined}
    >
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>

---
import type { Article } from "../../../../../src/model/index.ts";
import {
  articleLanguages,
  linkedRecords,
  renderArticleHtml,
} from "../../../../../src/site/articles.ts";
import {
  ARTICLE_GENERATOR_LABELS,
  formatPartialDate,
  REVIEW_STATUS_LABELS,
  TRANSLATION_STATUS_LABELS,
} from "../../../../../src/site/format.ts";
import {
  choose,
  langParam,
  languageFromParam,
  pick,
  textOf,
  ui,
} from "../../../../../src/site/i18n.ts";
import { articleJsonLd } from "../../../../../src/site/jsonld.ts";
import CiteThisPage from "../../../components/CiteThisPage.astro";
import DateRange from "../../../components/DateRange.astro";
import ExportMenu from "../../../components/ExportMenu.astro";
import FixtureBanner from "../../../components/FixtureBanner.astro";
import T from "../../../components/T.astro";
import TranslationNotice from "../../../components/TranslationNotice.astro";
import Base from "../../../layouts/Base.astro";
import { assetHref, href } from "../../../lib/links.ts";
import { getArticles, getModel } from "../../../lib/model.ts";

export function getStaticPaths() {
  return (["it", "en"] as const).flatMap((lang) =>
    getArticles().map((article) => ({
      params: { lang: langParam(lang), id: article.id },
      props: { article },
    })),
  );
}

const { article } = Astro.props as { article: Article };
const lang = languageFromParam(Astro.params.lang);
const c = (it: string, en: string) => choose(lang, it, en);
const model = getModel();
const body = pick(article.body, lang);
const linked = linkedRecords(article, model, lang);
const linkedEntities = linked.filter((r) => r.collection === "entities");
const evidenceCounts: Record<string, number> = {
  E1: 0,
  E2: 0,
  E3: 0,
  E4: 0,
  E5: article.links.hypotheses.length,
};
for (const relId of article.links.relationships) {
  const rel = model.dataset.relationships.find((r) => r.id === relId);
  if (rel) evidenceCounts[rel.evidence_level] = (evidenceCounts[rel.evidence_level] ?? 0) + 1;
}
const groups = [
  ["events", c("Eventi", "Events")],
  ["entities", c("Entità", "Entities")],
  ["relationships", c("Relazioni", "Relationships")],
  ["hypotheses", c("Ipotesi aperte (non accertate)", "Open hypotheses (not established)")],
] as const;
const downloads = articleLanguages(article);
const repo = "https://github.com/amattis96/our-enemies-monitor";
const translation = article.review.translations?.en;
const { kind, tool, run_date } = article.generated_by;
const siteUrl = new URL(assetHref(""), Astro.site ?? "http://localhost").href.replace(/\/$/, "");
const pageUrl = new URL(href(`articles/${article.id}/`, lang), Astro.site ?? "http://localhost")
  .href;
const jsonLd = articleJsonLd({
  siteUrl,
  lang,
  pageUrl,
  article,
});
const markdownAlternates = downloads.map((code) => ({
  href: assetHref(`articles/${article.id}.${code}.md`),
  type: "text/markdown",
  title: `${article.id} (Markdown, ${code})`,
}));
const generation = [
  ARTICLE_GENERATOR_LABELS[kind][lang],
  tool && `: ${tool}`,
  run_date && ` (${formatPartialDate(run_date, lang)})`,
]
  .filter(Boolean)
  .join("");
---

<Base title={textOf(article.title, lang)} lang={lang} description={textOf(article.summary, lang)} alternates={markdownAlternates} jsonLd={jsonLd} searchable>
  {article.fixture && <FixtureBanner lang={lang} />}
  <article class="article">
    <p class="kicker kicker-signal">
      <a href={href("articles/", lang)} class="text-inherit no-underline">{ui(lang).navArticles}</a> · {article.id}
    </p>
    <h1 class="article-title"><T text={article.title} lang={lang} /></h1>
    <p class="article-dek"><T text={article.summary} lang={lang} /></p>
    <aside class="dossier-rail card" aria-label={c("Nel fascicolo", "In the dossier")} data-pagefind-ignore>
      <p class="kicker" style="margin:0;">{c("Nel fascicolo", "In the dossier")}</p>
      <p class="meta" style="margin:0.35rem 0;">
        {c("Entità citate:", "Cited entities:")} <b>{linkedEntities.length}</b> ·{" "}
        {c("Record collegati:", "Linked records:")} <b>{linked.length}</b>
      </p>
      <p class="mono text-xs" style="margin:0.35rem 0;">
        E1:{evidenceCounts.E1} · E2:{evidenceCounts.E2} · E3:{evidenceCounts.E3} · E4:{evidenceCounts.E4} · E5:{evidenceCounts.E5}
      </p>
      {linkedEntities.length > 0 && (
        <ul class="list-disc pl-5 text-sm my-2">
          {linkedEntities.slice(0, 5).map((ent) => (
            <li><a href={href(ent.path, lang)}>{ent.label}</a></li>
          ))}
        </ul>
      )}
      <div class="flex flex-wrap gap-2 mt-2 text-xs">
        <a class="chip" href={href("network/", lang)}>{c("Apri sulla bacheca", "Open on the board")}</a>
        <a class="chip" href={href("timeline/", lang)}>{c("Eventi in cronologia", "Events on timeline")}</a>
      </div>
    </aside>
    <ExportMenu
      class="export-start article-export"
      label={ui(lang).exportLabel}
      groups={[
        {
          title: c("Testo e fonti", "Text and sources"),
          items: downloads.map((code) => ({
            format: "MD",
            label: `Markdown, ${code === "it" ? c("italiano", "Italian") : c("inglese", "English")}`,
            detail: c("Testo, riferimenti e record collegati; si apre in qualsiasi editor", "Text, references and linked records; opens in any editor"),
            href: assetHref(`articles/${article.id}.${code}.md`),
            name: `${article.id}.${code}.md`,
          })),
        },
        {
          title: c("Documento", "Document"),
          items: [{ format: "PDF", label: c("Stampa o salva in PDF", "Print or save as PDF"), detail: c("Impaginazione di stampa, URL delle fonti in chiaro", "Print layout, source URLs spelled out"), print: true }],
        },
      ]}
    />
    <p class="article-byline mono">
      <span><DateRange start={article.date} lang={lang} /></span>
      {article.updated && <span>{c("aggiornato il", "updated")} <DateRange start={article.updated} lang={lang} /></span>}
      <span>{ARTICLE_GENERATOR_LABELS[article.generated_by.kind][lang]}</span>
      <span>{REVIEW_STATUS_LABELS[article.review.status][lang]}</span>
    </p>
    {
      article.review.status === "ai_verified" && (
        <div class="notice" role="note">
          {c(
            "Analisi verificata da agenti IA (Task C e D), non approvata da un revisore umano. I fatti, le attribuzioni e le ipotesi sono distinti nel testo; fonti e correzioni sono consultabili nel repository.",
            "AI-verified analysis (Tasks C and D), not approved by a human editor. Facts, attributions and hypotheses are distinguished in the text; sources and corrections are available in the repository.",
          )}
        </div>
      )
    }
    {
      article.review.status === "needs_review" && !article.fixture && (
        <div class="notice">{c("Bozza in attesa di revisione editoriale.", "Draft awaiting editorial review.")}</div>
      )
    }
    <TranslationNotice review={article.review} lang={lang} />
    {
      body.fallback && (
        <p class="meta italic" data-pagefind-ignore>
          No English translation yet: the Italian original is shown.
        </p>
      )
    }
    <div class="article-body" lang={body.fallback ? "it" : undefined} set:html={renderArticleHtml(body.value)} />

    <h2 id="references" class="section-title">{c("Riferimenti", "References")}</h2>
    <ol class="list-decimal pl-6 space-y-1 wrap-anywhere">
      {
        article.references.map((reference) =>
          "source" in reference ? (
            <li>
              <a class="badge font-mono" href={href(`sources/${reference.source}/`, lang)}>{reference.source}</a>{" "}
              {model.source(reference.source) ? <T text={model.source(reference.source)!.title} lang={lang} /> : reference.source}
              {reference.note && <> — <span lang="it">{reference.note}</span></>}
            </li>
          ) : (
            <li>
              <a href={reference.url} rel="noopener">{reference.title}</a>
              {reference.publisher && <>. {reference.publisher}</>}
              {reference.published && <>, {formatPartialDate(reference.published, lang)}</>}.{" "}
              <span class="meta">{c("Consultato il", "Accessed")} {formatPartialDate(reference.accessed, lang)}</span>
            </li>
          ),
        )
      }
    </ol>
  </article>

  {
    linked.length > 0 && (
      <section data-pagefind-ignore>
        <h2 id="linked" class="section-title">{c("Record collegati", "Linked records")}</h2>
        <p class="meta max-w-3xl">
          {c(
            "Record canonici discussi dall'articolo. Le evidenze, i livelli e lo stato di revisione sono quelli delle rispettive pagine.",
            "Canonical records discussed by the article. Evidence, levels and review status are those of their own pages.",
          )}
        </p>
        {groups.map(([collection, label]) => {
          const items = linked.filter((record) => record.collection === collection);
          return items.length > 0 && (
            <>
              <h3>{label}</h3>
              <ul class="list-disc pl-5">
                {items.map((record) => (
                  <li><a href={href(record.path, lang)}><span class="font-mono">{record.id}</span></a>: {record.label}</li>
                ))}
              </ul>
            </>
          );
        })}
      </section>
    )
  }

  <section class="record-footer" data-pagefind-ignore>
    <h2>{c("Download e provenienza", "Download and provenance")}</h2>
    <ul class="list-disc pl-5 wrap-anywhere">
      {
        downloads.map((code) => (
          <li>
            <a href={assetHref(`articles/${article.id}.${code}.md`)} download hreflang={code}>
              Markdown ({code === "it" ? "italiano" : "English"})
            </a>
          </li>
        ))
      }
      <li>
        <a href={`${repo}/blob/main/content/articles/${article.id}.it.md`}>{c("File canonico", "Canonical file")} {article.id}.it.md</a>{" "}
        (<a href={`${repo}/commits/main/content/articles/${article.id}.it.md`}>{ui(lang).recordHistory}</a>)
      </li>
    </ul>
    <p>
      {generation}.{" "}
      {ui(lang).reviewStatus}: {REVIEW_STATUS_LABELS[article.review.status][lang]}
      {translation && <> · English: {TRANSLATION_STATUS_LABELS[translation.status][lang]}</>}.
      {article.review.notes.map((note) => <span class="block" lang="it">{note}</span>)}
    </p>
  </section>
  <CiteThisPage
    title={textOf(article.title, lang)}
    url={pageUrl}
    lang={lang}
    id={article.id}
    generatedAt={article.generated_by.run_date ?? "2026-11-25"}
  />
</Base>

<style>
  .article {
    max-width: 46rem;
    margin: 0 auto;
  }
  .article-title {
    margin-top: 0.5rem;
    font-size: var(--text-3xl);
    font-variation-settings: "opsz" 72;
  }
  .article-dek {
    font: italic 400 var(--text-xl) / 1.35 var(--font-serif);
    color: var(--ink-2);
  }
  .article-byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    padding: var(--space-3) 0;
    margin: var(--space-4) 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
</style>

---
import { formatPartialDate, REVIEW_STATUS_LABELS } from "../../../../../src/site/format.ts";
import { choose, languageFromParam, languagePaths, ui } from "../../../../../src/site/i18n.ts";
import ExportMenu from "../../../components/ExportMenu.astro";
import FixtureBanner from "../../../components/FixtureBanner.astro";
import T from "../../../components/T.astro";
import Base from "../../../layouts/Base.astro";
import { assetHref, href } from "../../../lib/links.ts";
import { getArticles } from "../../../lib/model.ts";

export const getStaticPaths = () => languagePaths();
const lang = languageFromParam(Astro.params.lang);
const c = (it: string, en: string) => choose(lang, it, en);
const articles = getArticles();
const fixtures = articles.some((article) => article.fixture);
const statuses = [...new Set(articles.map((a) => a.review.status))];
const generatorKinds = [...new Set(articles.map((a) => a.generated_by.kind))];
---

<Base
  title={c("Indagini", "Investigations")}
  lang={lang}
  description={c("Analisi tematiche basate sulle fonti, collegate ai record della base di conoscenza.", "Source-based thematic analyses linked to the records of the knowledge base.")}
>
  <p class="kicker kicker-signal">{c("Indagini", "Investigations")}</p>
  <div class="title-row">
    <h1>{c("Indagini e analisi", "Investigations and analyses")}</h1>
    <ExportMenu
      label={ui(lang).exportLabel}
      groups={[{
        title: ui(lang).exportDataset,
        items: [{ format: "JSON", label: c("Indice degli articoli", "Article index"), detail: c("Titoli, sintesi, record collegati e link ai file Markdown", "Titles, summaries, linked records and links to the Markdown files"), href: assetHref("data/v1/articles.json") }],
      }]}
    />
  </div>
  <p class="lede">
    {c(
      "Analisi tematiche in italiano e inglese. Ogni articolo cita le proprie fonti e rimanda ai record canonici che discute: le evidenze restano nei record, con il loro livello e il loro stato di revisione. Un articolo non trasforma una vicinanza nel grafo o un'ipotesi in una prova.",
      "Thematic analyses in Italian and English. Each article cites its sources and links the canonical records it discusses: the evidence stays in those records, with their level and review status. An article does not turn graph proximity or a hypothesis into proof.",
    )}
  </p>

  {articles.length > 0 && (
    <div class="flex flex-wrap gap-2 my-4" role="group" aria-label={c("Filtra indagini", "Filter investigations")} data-article-filters>
      <button type="button" class="chip" data-filter-status="" aria-pressed="true">{c("Tutti", "All")} ({articles.length})</button>
      {statuses.map((st) => (
        <button type="button" class="chip" data-filter-status={st} aria-pressed="false">
          {REVIEW_STATUS_LABELS[st][lang]}
        </button>
      ))}
      {generatorKinds.map((gk) => (
        <button type="button" class="chip" data-filter-kind={gk} aria-pressed="false">
          {gk}
        </button>
      ))}
    </div>
  )}

  {
    fixtures && (
      <div class="test-banner max-w-3xl" role="note">
        <strong>DEMO / TEST</strong>{" "}
        {c(
          "Gli articoli marcati DEMO / TEST sono contenuti di prova: servono a verificare la sezione finché non arrivano analisi reali.",
          "Articles marked DEMO / TEST are test content: they exercise this section until real analyses arrive.",
        )}
      </div>
    )
  }
  {
    articles.length === 0 ? (
      <p class="meta">{c("Nessun articolo pubblicato.", "No article published.")}</p>
    ) : (
      <ul class="grid gap-6 md:grid-cols-2 mt-6" data-article-list>
        {articles.map((article) => (
          <li
            class:list={["card", article.fixture && "card-test"]}
            data-status={article.review.status}
            data-kind={article.generated_by.kind}
          >
            <p class="meta">
              {article.fixture && <><FixtureBanner lang={lang} compact />{" "}</>}
              <time datetime={article.date}>{formatPartialDate(article.date, lang)}</time> ·{" "}
              <span class="font-mono">{article.id}</span> · {REVIEW_STATUS_LABELS[article.review.status][lang]}
            </p>
            <h2 class="mt-2 text-xl">
              <a href={href(`articles/${article.id}/`, lang)}><T text={article.title} lang={lang} /></a>
            </h2>
            <p class="mb-0"><T text={article.summary} lang={lang} /></p>
          </li>
        ))}
      </ul>
    )
  }
</Base>

<script is:inline>
  (() => {
    const bar = document.querySelector("[data-article-filters]");
    const list = document.querySelector("[data-article-list]");
    if (!bar || !list) return;
    let activeStatus = "";
    let activeKind = "";
    const apply = () => {
      for (const li of Array.from(list.children)) {
        const st = li.getAttribute("data-status") || "";
        const kd = li.getAttribute("data-kind") || "";
        li.hidden = (activeStatus && st !== activeStatus) || (activeKind && kd !== activeKind);
      }
    };
    for (const btn of Array.from(bar.querySelectorAll("button"))) {
      btn.addEventListener("click", () => {
        if (btn.hasAttribute("data-filter-status")) {
          activeStatus = btn.getAttribute("data-filter-status") || "";
          for (const b of Array.from(bar.querySelectorAll("[data-filter-status]"))) {
            b.setAttribute("aria-pressed", String(b === btn));
          }
        }
        if (btn.hasAttribute("data-filter-kind")) {
          const val = btn.getAttribute("data-filter-kind") || "";
          activeKind = activeKind === val ? "" : val;
          for (const b of Array.from(bar.querySelectorAll("[data-filter-kind]"))) {
            b.setAttribute("aria-pressed", String((b.getAttribute("data-filter-kind") || "") === activeKind));
          }
        }
        apply();
      });
    }
  })();
</script>

---
import { choose, languageFromParam, languagePaths } from "../../../../../src/site/i18n.ts";
import { projectLaboratory } from "../../../../../src/site/laboratory.ts";
import { buildSituationRoom } from "../../../../../src/site/stix.ts";
import T from "../../../components/T.astro";
import Base from "../../../layouts/Base.astro";
import { assetHref, href } from "../../../lib/links.ts";
import { getModel } from "../../../lib/model.ts";
import "../../../styles/lab.css";

export const getStaticPaths = () => languagePaths();
const lang = languageFromParam(Astro.params.lang);
const c = (it: string, en: string) => choose(lang, it, en);

const model = getModel();
const situation = buildSituationRoom(model, projectLaboratory(model));
---

<Base
  title={c("Archivio brief", "Briefs archive")}
  lang={lang}
  wide={true}
  description={c(
    "Archivio dei brief periodici dell'osservatorio, basati solo sui record pubblici. Nessun brief è ancora pubblicato: la generazione è in prova.",
    "Archive of the observatory's periodic briefs, based only on public records. No brief is published yet: generation is in trial.",
  )}
>
  <div class="lab-sheet">
    <span class="lab-register-badge">{c("Osservatorio · Brief", "Observatory · Briefs")}</span>
    <h1 class="mt-3">{c("Brief periodici", "Periodic briefs")}</h1>
    <p class="lede max-w-3xl">
      {c(
        "I brief saranno sintesi periodiche basate solo sui record pubblici, con il collegamento a ogni scheda e al suo caveat. La generazione è ancora in prova interna: finora non è stato pubblicato alcun brief.",
        "Briefs will be periodic summaries based only on public records, linking every record and its caveat. Generation is still in internal trial: no brief has been published so far.",
      )}{" "}
      <a href={href("situazione/", lang)}>{c("Sala situazione", "Situation room")}</a> ·{" "}
      <a href={assetHref("data/v1/index.json")}>{c("Catalogo dati JSON", "JSON data catalog")}</a>.
    </p>

    <section class="mt-6">
      <h2>{c("Nel frattempo: ultimi eventi integrati", "Meanwhile: latest integrated events")}</h2>
      <div class="lab-cards">
        {situation.latest_events.map((item) => (
          <article class="lab-card">
            <div class="lab-card-header">
              <span class="lab-code">{item.id}</span>
              <span class="lab-pill">{item.date}</span>
            </div>
            <p class="mb-0 font-semibold"><T text={item.title} lang={lang} /></p>
            <p class="meta mb-0">{choose(lang, item.caveat.it, item.caveat.en ?? item.caveat.it)}</p>
            <a class="meta" href={href(item.hrefPath, lang)}>{c("Scheda", "Record")} →</a>
          </article>
        ))}
      </div>
    </section>
  </div>
</Base>

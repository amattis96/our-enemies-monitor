---
import { EVIDENCE_LEVELS, THEME_LABELS } from "../../../../src/model/index.ts";
import { choose, languageFromParam, languagePaths, textOf } from "../../../../src/site/i18n.ts";
import { projectLaboratory } from "../../../../src/site/laboratory.ts";
import Base from "../../layouts/Base.astro";
import { href } from "../../lib/links.ts";
import { getModel } from "../../lib/model.ts";
import "../../styles/lab.css";

export const getStaticPaths = () => languagePaths();
const lang = languageFromParam(Astro.params.lang);
const c = (it: string, en: string) => choose(lang, it, en);

const lab = projectLaboratory(getModel());
---

<Base
  title={c("Copertura del dataset", "Dataset coverage")}
  lang={lang}
  wide={true}
  description={c(
    "Riepilogo della copertura per livello di evidenza, tema e scomposizione probatoria.",
    "Coverage summary by evidence level, theme, and evidentiary breakdown.",
  )}
>
  <div class="lab-sheet">
    <span class="lab-register-badge">{c("Laboratorio · Copertura", "Laboratory · Coverage")}</span>
    <h1 class="mt-3">{c("Copertura probatoria e tematica", "Evidentiary & thematic coverage")}</h1>
    <p class="lede max-w-3xl">
      {c(
        "Misura della copertura dei record pubblici per livello di evidenza (E1–E5) e per area tematica.",
        "Measurement of public record coverage by evidence level (E1–E5) and thematic area.",
      )}
    </p>

    <nav class="lab-subnav" aria-label={c("Viste del laboratorio", "Laboratory views")}>
      <a href={href("laboratorio/", lang)}>{c("Area unificata", "Unified view")}</a>
      <a href={href("domande/", lang)}>{c("Domande aperte", "Open questions")}</a>
      <a href={href("cold-case/", lang)}>{c("Cold case", "Cold cases")}</a>
      <a href={href("copertura/", lang)} aria-current="page">{c("Copertura", "Coverage")}</a>
    </nav>

    <section class="grid gap-4 md:grid-cols-5 mt-6">
      <div class="card">
        <p class="meta">{c("Eventi", "Events")}</p>
        <p class="text-xl font-mono font-semibold">{lab.coverage.events_total}</p>
      </div>
      <div class="card">
        <p class="meta">{c("Entità", "Entities")}</p>
        <p class="text-xl font-mono font-semibold">{lab.coverage.entities_total}</p>
      </div>
      <div class="card">
        <p class="meta">{c("Relazioni", "Relationships")}</p>
        <p class="text-xl font-mono font-semibold">{lab.coverage.relationships_total}</p>
      </div>
      <div class="card">
        <p class="meta">{c("Ipotesi", "Hypotheses")}</p>
        <p class="text-xl font-mono font-semibold">{lab.coverage.hypotheses_total}</p>
      </div>
      <div class="card">
        <p class="meta">{c("Schede «Perché lo sappiamo?»", "«Why do we know?» records")}</p>
        <p class="text-xl font-mono font-semibold">{lab.coverage.records_with_why_we_know}</p>
      </div>
    </section>

    <section class="mt-8">
      <h2>{c("Livelli di evidenza", "Evidence levels")}</h2>
      <div class="flex flex-wrap gap-3 mt-3">
        {EVIDENCE_LEVELS.map((lvl) => (
          <span class="lab-pill">
            {lvl}: {lab.coverage.by_evidence_level[lvl]}
          </span>
        ))}
      </div>
    </section>

    <section class="mt-8">
      <h2>{c("Copertura per tema", "Coverage by theme")}</h2>
      <div class="relative overflow-x-auto mt-3">
        <table>
          <thead>
            <tr>
              <th scope="col">{c("Tema", "Theme")}</th>
              <th scope="col">{c("Eventi", "Events")}</th>
              <th scope="col">{c("Relazioni", "Relationships")}</th>
              <th scope="col">{c("Domande aperte", "Open questions")}</th>
            </tr>
          </thead>
          <tbody>
            {lab.coverage.by_theme.map((row) => (
              <tr>
                <td>{textOf(THEME_LABELS[row.theme], lang)}</td>
                <td class="font-mono">{row.events}</td>
                <td class="font-mono">{row.relationships}</td>
                <td class="font-mono">{row.hypotheses}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</Base>

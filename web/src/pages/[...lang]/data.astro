---
import { choose, languageFromParam, languagePaths, ui } from "../../../../src/site/i18n.ts";
import { datasetJsonLd } from "../../../../src/site/jsonld.ts";
import Base from "../../layouts/Base.astro";
import { assetHref, href } from "../../lib/links.ts";
import { getExports } from "../../lib/model.ts";

export const getStaticPaths = () => languagePaths();
const lang = languageFromParam(Astro.params.lang);
const c = (it: string, en: string) => choose(lang, it, en);
const { manifest } = getExports();
const kb = (bytes: number) => `${(bytes / 1024).toFixed(1)} KB`;
// The per-record packages are summarised in one row: the catalog lists them all.
const packages = manifest.files.filter((file) => file.path.startsWith("records/"));
const listed = manifest.files.filter((file) => !file.path.startsWith("records/"));
const siteUrl = new URL(assetHref(""), Astro.site ?? "http://localhost").href.replace(/\/$/, "");
const jsonLd = datasetJsonLd({
  siteUrl,
  lang,
  pageUrl: new URL(href("data/", lang), Astro.site ?? "http://localhost").href,
  commit: manifest.commit,
  commitDate: manifest.commit_date,
  files: listed.filter((file) => !file.path.startsWith("schemas/")).map((file) => file.path),
});
---

<Base title={ui(lang).navData} lang={lang} description={c("Dati canonici scaricabili e schemi JSON.", "Downloadable canonical data and JSON Schemas.")} jsonLd={jsonLd}>
  <p class="kicker">{ui(lang).navMethod}</p>
  <h1>{c("Dati aperti", "Open data")}</h1>
  <div class="max-w-3xl">
    <p>
      {c(
        "I dati originali del progetto sono dedicati al pubblico dominio con CC0 1.0: si possono copiare, ripubblicare e riusare anche commercialmente, senza obbligo di attribuzione. Conservare fonti, avvertenze e correzioni è comunque raccomandato per l'integrità della ricerca. I materiali di terzi citati (articoli, documenti ufficiali) mantengono i propri diritti.",
        "The project's original data is dedicated to the public domain under CC0 1.0: it may be copied, republished and reused, including commercially, with no attribution requirement. Keeping sources, caveats and corrections is still recommended for research integrity. Cited third-party materials (articles, official documents) keep their own rights.",
      )}
    </p>
    <p class="meta">
      {c("Versione di export", "Export version")} {manifest.export_version}
      {manifest.commit && <> · commit <span class="font-mono">{manifest.commit.slice(0, 7)}</span></>}
      {manifest.commit_date && <> · <time datetime={manifest.commit_date}>{manifest.commit_date.slice(0, 10)}</time></>} ·{" "}
      <a href={assetHref("data/v1/manifest.json")}>manifest.json</a>
      {c(" (conteggi e SHA-256 di ogni file)", " (counts and SHA-256 of every file)")}
    </p>
    <p>
      {c("Prima di leggere i dati:", "Before reading the data:")}{" "}
      <a href={assetHref("data/v1/vocabulary.json")}>vocabulary.json</a>
      {c(
        " definisce livelli di evidenza (tipi di base, non una scala), classi, stati e le regole di lettura R1–R5;",
        " defines evidence levels (kinds of basis, not a scale), classes, statuses and reading rules R1–R5;",
      )}{" "}
      <a href={assetHref("data/v1/index.json")}>index.json</a>
      {c(
        " è il catalogo, con lingua canonica, conteggi pubblicati e trattenuti e tre date distinte: commit, ultimo evento pubblico, ultima fonte archiviata.",
        " is the catalog, with canonical language, published and withheld counts and three distinct dates: commit, latest public event, latest archived source.",
      )}{" "}
      <a href={assetHref("data/v1/inferences.json")}>inferences.json</a>
      {c(
        " elenca le inferenze vietate pubbliche, la classificazione dei caveat negativi e i cammini del grafo che attraversano un limite di composizione, con lo stato di revisione di ogni voce.",
        " lists the public forbidden inferences, the classification of negative caveats and the graph paths that cross a composition limit, with the review state of each entry.",
      )}
    </p>
  </div>

  <div class="relative overflow-x-auto">
    <table>
      <thead>
        <tr>
          <th scope="col">{c("File", "File")}</th>
          <th scope="col">{c("Dimensione", "Size")}</th>
          <th scope="col">SHA-256</th>
        </tr>
      </thead>
      <tbody>
        {listed.map((file) => (
          <tr>
            <td><a href={assetHref(`data/v1/${file.path}`)}>{file.path}</a></td>
            <td class="whitespace-nowrap">{kb(file.bytes)}</td>
            <td class="font-mono text-xs break-all">{file.sha256}</td>
          </tr>
        ))}
        <tr>
          <td class="font-mono">records/&lt;ID&gt;.json</td>
          <td class="whitespace-nowrap">{packages.length} {c("file", "files")} · {kb(packages.reduce((n, file) => n + file.bytes, 0))}</td>
          <td>{c("SHA-256 di ciascun pacchetto in", "SHA-256 of each package in")} <a href={assetHref("data/v1/manifest.json")}>manifest.json</a></td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>{c("Perimetro di pubblicazione", "Publication scope")}</h2>
  <p class="max-w-3xl">{c("Questi export e il portale omettono le proposte needs_review, gli eventi pending_integration e le relazioni su persone con primary_url mancante o non registrato per la relazione. I record storici imported_unreviewed con provenienza dalla baseline originale rimangono consultabili come materiale provvisorio, non come fatti indipendentemente verificati. Il repository Git mantiene tutte le proposte e la loro cronologia.", "These exports and the portal omit needs_review proposals, pending_integration events and named-person relationships whose primary_url is missing or unregistered for the relationship. Legacy imported_unreviewed records with original baseline provenance remain visible as provisional research, not independently verified facts. The Git repository retains all proposals and their history.")}</p>

  <p class="max-w-3xl">{c("Il registro withheld.json elenca soltanto ID, collezione e motivi generici dei record trattenuti: un ID assente dal portale può essere trattenuto oppure inesistente. Le ipotesi storiche mostrano solo i collegamenti a eventi pubblici e le citazioni originali ancora presenti; note e aggiornamenti non revisionati sono omessi.", "The withheld.json registry lists only IDs, collections and generic reasons for withheld records: an ID absent from the portal may be withheld or nonexistent. Legacy hypotheses show only public event links and original citations still present; unreviewed notes and updates are omitted.")}</p>
  <h2>{c("Formato", "Format")}</h2>
  <ul class="list-disc pl-5 max-w-3xl space-y-1">
    <li>{c("Ogni file contiene una proiezione pubblicabile dei dati canonici. I record in revisione e le relazioni riguardanti persone con URL primario mancante o non registrato per la relazione restano soltanto nell’archivio Git; la baseline non revisionata è segnalata come provvisoria.", "Each collection file contains a publication-filtered projection of the canonical records. Pending candidates and named-person links with a missing or unregistered primary URL remain in the Git archive; the unreviewed baseline remains explicitly provisional.")}</li>
    <li>{c("records/<ID>.json è il pacchetto di un singolo record pubblicato: il record, la citazione della proiezione pubblica esportata (cite_as: commit, percorso del pacchetto, SHA-256 del record), il file canonico in Git solo come provenienza (canonical_source: con relation «filtered» contiene campi trattenuti e non coincide con il pacchetto), gli ID dei record pubblicati collegati. Un ID trattenuto non ha pacchetto. Ogni pagina di evento, entità, ipotesi e fonte rimanda al proprio pacchetto con un link rel=alternate.", "records/<ID>.json is the package of one published record: the record, the citation of the exported public projection (cite_as: commit, package path, SHA-256 of the record), the canonical file in Git for provenance only (canonical_source: with relation "filtered" it holds withheld fields and is not the package content), and the IDs of the published records it is linked to. A withheld ID has no package. Each event, entity, hypothesis and source page points to its own package with a rel=alternate link.")}</li>
    <li>{c("articles.json elenca solo gli articoli editoriali che superano il gate di pubblicazione (esclusi i fixture di prova); changes.feed.json è un JSON Feed 1.1 dei commit che aggiungono o modificano record pubblicati, con le stesse regole della pagina Modifiche.", "articles.json lists only the editorial articles that pass the publication gate (demo fixtures excluded); changes.feed.json is a JSON Feed 1.1 of the commits that add or modify published records, under the same rules as the Changes page.")}</li>
    <li>{c("all.json contiene tutte le collezioni in un unico oggetto.", "all.json contains every collection in a single object.")}</li>
    <li>{c("graph.json conserva per ogni relazione il caveat bilingue completo o null; hypotheses-graph.json contiene separatamente le ipotesi. Entrambi sono inclusi nel manifest.", "graph.json preserves each relationship’s full bilingual caveat or null; hypotheses-graph.json contains hypotheses separately. Both are included in the manifest.")}</li>
    <li>{c("Gli schemi JSON (draft 2020-12) descrivono ogni record, con una descrizione per ogni campo, e sono generati dal modello del progetto.", "The JSON Schemas (draft 2020-12) describe every record, with a description for every field, and are generated from the project model.")}</li>
    <li>{c("Il testo canonico è in italiano (campo it); en è una traduzione, con stato in review.translations.", "Canonical text is Italian (field it); en is a translation, with its status in review.translations.")}</li>
    <li>{c("Il campo provenance riporta file e riga del corpus originale da cui deriva ogni record.", "The provenance field gives the original corpus file and row each record comes from.")}</li>
  </ul>

  <h2>{c("Ricostruire da zero", "Rebuild from scratch")}</h2>
  <p class="max-w-3xl">
    {c(
      "Il sito e questi file si rigenerano da un fork del repository con software libero, senza account né servizi a pagamento:",
      "The site and these files can be regenerated from a fork of the repository with free software, with no account or paid service:",
    )}
  </p>
  <pre class="card bg-wash overflow-x-auto text-sm"><code>git clone https://github.com/amattis96/our-enemies-monitor.git
cd our-enemies-monitor
pnpm install
pnpm check
SITE_URL=https://example.org BASE_PATH=/ pnpm build   # → web/dist</code></pre>
</Base>

---
import { choose, languageFromParam, languagePaths } from "../../../../../src/site/i18n.ts";
import {
  type ElectionDossierProjection,
  projectElectionDossiers,
} from "../../../../../src/site/stix.ts";
import T from "../../../components/T.astro";
import Base from "../../../layouts/Base.astro";
import { href } from "../../../lib/links.ts";
import { getModel } from "../../../lib/model.ts";
import "../../../styles/lab.css";

export function getStaticPaths() {
  const dossiers = projectElectionDossiers(getModel());
  return languagePaths().flatMap((lp) =>
    dossiers.map((dossier) => ({
      params: { lang: lp.params.lang, id: dossier.id },
      props: { dossier },
    })),
  );
}

const lang = languageFromParam(Astro.params.lang);
const c = (it: string, en: string) => choose(lang, it, en);
const { dossier } = Astro.props as { dossier: ElectionDossierProjection };
const ev = dossier.event;
---

<Base
  title={`${c("Dossier elettorale", "Election dossier")} ${dossier.id}`}
  lang={lang}
  wide={true}
  description={c(
    "Dossier sugli eventi a rischio elettorale con livelli di evidenza e avvertenze metodologiche.",
    "Election risk-event dossier with evidence levels and methodological caveats.",
  )}
>
  <div class="lab-sheet">
    <span class="lab-register-badge">{c("Dossier · Rischio elettorale", "Dossier · Election risk")}</span>
    <h1 class="mt-3"><T text={ev.title} lang={lang} /></h1>
    <p class="meta">
      {dossier.id} · {ev.date.start} · {ev.evidence_level ?? "N/D"} · {ev.review.status}
    </p>
    <div class="notice max-w-3xl mt-4">
      {choose(lang, dossier.caveat.it, dossier.caveat.en)}
    </div>

    <section class="mt-6 max-w-3xl">
      <h2>{c("Fatto o evento registrato", "Recorded fact or event")}</h2>
      <p class="mt-2"><T text={ev.description} lang={lang} /></p>
      <p class="meta">
        <a href={href(`events/${ev.id}/`, lang)}>{c("Apri scheda evento completa", "Open full event record")} →</a>
      </p>
    </section>

    <section class="mt-8">
      <h2>{c("Relazioni pubbliche citate", "Cited public relationships")}</h2>
      {dossier.documentedRelationships.length === 0 ? (
        <p class="meta mt-2">{c("Nessuna relazione pubblica diretta associata.", "No direct public relationships associated.")}</p>
      ) : (
        <div class="lab-cards">
          {dossier.documentedRelationships.map((rel) => (
            <article class="lab-card">
              <div class="lab-card-header">
                <span class="lab-code">{rel.id}</span>
                <span class="lab-pill">{rel.evidence_level}</span>
              </div>
              <p class="mb-0 font-mono text-sm">
                {rel.subject} → {rel.predicate} → {rel.object}
              </p>
              {rel.caveat && <p class="meta mb-0"><T text={rel.caveat} lang={lang} /></p>}
            </article>
          ))}
        </div>
      )}
    </section>
  </div>
</Base>

---
import type { Entity } from "../../../../../src/model/index.ts";
import {
  countryName,
  ENTITY_KIND_LABELS,
  formatDateRange,
  formatPartialDate,
  formatPredicate,
  RELATION_GROUP_LABELS,
} from "../../../../../src/site/format.ts";
import { choose, langParam, languageFromParam, textOf, ui } from "../../../../../src/site/i18n.ts";
import { isParticipation } from "../../../../../src/site/read-model.ts";
import { roleMatrix } from "../../../../../src/site/roles.ts";
import { KIND_ICON, RELATION_GROUP_ICON } from "../../../../../src/site/visual.ts";
import ArticleBacklinks from "../../../components/ArticleBacklinks.astro";
import EvidenceStamp from "../../../components/EvidenceStamp.astro";
import Icon from "../../../components/Icon.astro";
import NodeLink from "../../../components/NodeLink.astro";
import RecordFooter from "../../../components/RecordFooter.astro";
import RelationshipTable from "../../../components/RelationshipTable.astro";
import T from "../../../components/T.astro";
import TranslationNotice from "../../../components/TranslationNotice.astro";
import Base from "../../../layouts/Base.astro";
import { assetHref, href, packageAlternate } from "../../../lib/links.ts";
import { getModel } from "../../../lib/model.ts";

export function getStaticPaths() {
  return (["it", "en"] as const).flatMap((lang) =>
    getModel().dataset.entities.map((entity) => ({
      params: { lang: langParam(lang), id: entity.id },
      props: { entity },
    })),
  );
}

const { entity } = Astro.props as { entity: Entity };
const lang = languageFromParam(Astro.params.lang);
const c = (it: string, en: string) => choose(lang, it, en);
const model = getModel();
const relationships = model.relationshipsOf(entity.id);
const direct = relationships.filter((r) => !isParticipation(r));
const participations = relationships
  .filter(isParticipation)
  .map((r) => ({ r, event: model.event(r.subject === entity.id ? r.object : r.subject) }))
  .sort((a, b) => (a.event?.date.start ?? "").localeCompare(b.event?.date.start ?? ""));
const hypotheses = model.hypothesesOf(entity.id);
const roles = roleMatrix(model, entity.id);
const levels = ["E1", "E2", "E3", "E4"] as const;
---

<Base title={textOf(entity.name, lang)} lang={lang} alternates={packageAlternate(entity.id)} searchable>
  <header class="page-head">
    <p class="kicker flex flex-wrap items-center gap-x-2">
      <a href={href("entities/", lang)}>{ui(lang).navArchive}</a> /
      <span class="inline-flex items-center gap-1"><Icon name={KIND_ICON[entity.kind]} />{ENTITY_KIND_LABELS[entity.kind][lang]}</span>
      · <span>{entity.id}</span> · {c("dominio", "domain")} {entity.domain}
      {entity.country && <> · <a href={`${href("atlas/", lang)}#${entity.country}`}>{countryName(entity.country, lang)}</a></>}
    </p>
    <h1><T text={entity.name} lang={lang} /></h1>
    <div class="kpis mt-4 entity-kpis">
      <a class="kpi" href="#direct"><b>{direct.length}</b><span class="kicker">{c("relazioni dirette", "direct relationships")}</span></a>
      <a class="kpi" href="#events"><b>{participations.length}</b><span class="kicker">{c("eventi", "events")}</span></a>
      <a class="kpi" href={`${href("network/", lang)}?focus=${entity.id}`}><b><Icon name="nav-network" /></b><span class="kicker">{c("apri sulla bacheca", "open on the board")}</span></a>
      <div><b>{hypotheses.length}</b><span class="kicker">{c("ipotesi aperte", "open hypotheses")}</span></div>
    </div>
  </header>
  <TranslationNotice review={entity.review} lang={lang} />

  {
    entity.kind === "person" && (
      <div class="notice max-w-3xl">
        {c(
          "Persona reale. Ogni relazione indica solo ciò che la fonte citata sostiene, con il proprio livello di evidenza. Un'attribuzione istituzionale non è una condanna; la partecipazione a un evento non implica responsabilità. Le relazioni prive di fonte primaria collegata restano riservate fino alla revisione. Per segnalare correzioni usare il repository GitHub.",
          "Real person. Each relationship states only what the cited source supports, with its own evidence level. An institutional attribution is not a conviction; participation in an event does not imply responsibility. Relationships without a linked primary source remain restricted until review. Use the GitHub repository to report corrections.",
        )}
      </div>
    )
  }

  {
    roles.total >= 3 && (
      <section aria-labelledby="roles-title">
        <h2 id="roles-title" class="section-title">{c("Matrice dei ruoli", "Role matrix")}</h2>
        <p class="meta max-w-3xl">
          {c(
            "Le relazioni pubbliche di questa entità contate per gruppo di relazione e livello di evidenza. Un conteggio non è un grado di responsabilità: la partecipazione a un evento è presenza o ruolo, non attribuzione.",
            "This entity's public relationships counted by relation group and evidence level. A count is not a degree of responsibility: participation in an event is presence or role, not attribution.",
          )}
        </p>
        <div class="table-wrap">
          <table class="roles">
            <caption class="sr-only">{c("Matrice dei ruoli", "Role matrix")}</caption>
            <thead>
              <tr>
                <th scope="col">{c("Gruppo", "Group")}</th>
                {levels.map((l) => <th scope="col" class="num"><EvidenceStamp level={l} lang={lang} variant="compact" /></th>)}
                <th scope="col" class="num">{c("Totale", "Total")}</th>
              </tr>
            </thead>
            <tbody>
              {roles.rows.map((row) => (
                <tr>
                  <th scope="row"><span class="inline-flex items-center gap-1"><Icon name={RELATION_GROUP_ICON[row.group]} />{RELATION_GROUP_LABELS[row.group][lang]}</span></th>
                  {levels.map((l) => <td class="num">{row.byLevel[l] || <span class="text-muted">·</span>}</td>)}
                  <td class="num"><b>{row.total}</b></td>
                </tr>
              ))}
              {roles.restricted > 0 && (
                <tr>
                  <th scope="row">{c("Riservate in attesa di fonte primaria", "Restricted pending a primary source")}</th>
                  <td colspan="4" class="meta">{c("gruppo non mostrato", "group not shown")}</td>
                  <td class="num"><b>{roles.restricted}</b></td>
                </tr>
              )}
            </tbody>
            <tfoot>
              <tr>
                <th scope="row">{c("Totale", "Total")}</th>
                {levels.map((l) => <td class="num">{roles.byLevel[l]}</td>)}
                <td class="num"><b>{roles.total}</b></td>
              </tr>
            </tfoot>
          </table>
        </div>
        <p class="meta text-sm max-w-3xl">
          {c("Base", "Base")}: {roles.total} {c("relazioni pubbliche", "public relationships")} ·{" "}
          {c("periodo", "period")}:{" "}
          {roles.period
            ? `${formatPartialDate(roles.period.from, lang)} – ${formatPartialDate(roles.period.to, lang)}`
            : c("nessun evento collegato", "no linked event")}
          {roles.undated > 0 && <> ({roles.undated} {c("senza evento collegato", "without a linked event")})</>} ·{" "}
          {c("fonte", "source")}: <a href={assetHref("data/v1/relationships.json")}>relationships.json</a>{" "}
          {c("(proiezione pubblica; gruppi e livelli esistenti, nessuna nuova classe di ruolo)", "(public projection; existing groups and levels, no new role class)")}
        </p>
        {roles.predicates.length > 0 && (
          <details class="max-w-3xl">
            <summary>
              {c("Ruoli letterali negli eventi", "Literal roles in events")}: {roles.predicates.length} {c("predicati distinti", "distinct predicates")}
            </summary>
            <ul class="roles-predicates">
              {roles.predicates.map((p) => (
                <li><span lang="it">{formatPredicate(p.predicate)}</span> <span class="meta">× {p.count}</span></li>
              ))}
            </ul>
          </details>
        )}
      </section>
    )
  }

  <h2 id="direct" class="section-title">{c("Relazioni dirette", "Direct relationships")} ({direct.length})</h2>
  <p class="meta max-w-3xl">
    {c(
      "Ogni predicato va letto letteralmente: «fornisce a» non significa «controlla», «sanziona» non significa «condanna».",
      "Each predicate must be read literally (predicates are kept in the original Italian): “supplies” does not mean “controls”, “sanctions” does not mean “convicts”.",
    )}
  </p>
  {
    direct.length > 0 ? (
      <RelationshipTable relationships={direct} caption={c("Relazioni dirette", "Direct relationships")} lang={lang} />
    ) : (
      <p class="meta">{c("Nessuna relazione diretta registrata.", "No direct relationship recorded.")}</p>
    )
  }

  <h2 id="events" class="section-title">{c("Eventi in cui compare", "Events it appears in")} ({participations.length})</h2>
  <p class="meta max-w-3xl">
    {c("Presenza o ruolo nell'evento, non prova di comando, finanziamento o coordinamento.", "Presence or role in the event, not proof of command, financing or coordination.")}
  </p>
  {
    participations.length > 0 ? (
      <ul class="event-rows">
        {participations.map(({ r, event }) => (
          <li>
            {event && <span class="meta">{formatDateRange(event.date.start, event.date.end, lang)} · </span>}
            <NodeLink id={r.subject === entity.id ? r.object : r.subject} lang={lang} />
            {model.isRestricted(r) ? (
              <span class="meta"> · {c("ruolo riservato in attesa di fonte primaria", "role restricted pending a primary source")}</span>
            ) : (
              <span class="meta"> · {c("ruolo", "role")}: <span lang="it">{formatPredicate(r.predicate)}</span></span>
            )}{" "}
            <EvidenceStamp level={r.evidence_level} lang={lang} variant="compact" />
          </li>
        ))}
      </ul>
    ) : (
      <p class="meta">{c("Nessun evento registrato.", "No event recorded.")}</p>
    )
  }

  {
    hypotheses.length > 0 && (
      <>
        <h2 class="section-title">{c("Ipotesi aperte che la riguardano", "Open hypotheses concerning it")} ({hypotheses.length})</h2>
        <p class="meta">{c("Domande investigative non dimostrate: non sono relazioni accertate.", "Unproven investigative questions: they are not established relationships.")}</p>
        <ul class="list-disc pl-5">
          {hypotheses.map((h) => (
            <li>
              <a href={href(`hypotheses/${h.id}/`, lang)}>{h.id}</a>: <T text={h.question} lang={lang} />
            </li>
          ))}
        </ul>
      </>
    )
  }

  <ArticleBacklinks id={entity.id} lang={lang} />

  <RecordFooter id={entity.id} collection="entities" review={entity.review} provenance={entity.provenance} lang={lang} />
</Base>

<style>
  .entity-kpis {
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 760px) {
    .entity-kpis {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .roles th,
  .roles td {
    padding-inline: 0.35rem;
  }
  .roles tbody th {
    font-size: var(--text-sm);
  }
  .roles .num {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .roles tfoot th,
  .roles tfoot td {
    border-top: 2px solid var(--rule-strong);
  }
  .roles-predicates {
    columns: 2 16rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .event-rows li {
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule);
  }
</style>

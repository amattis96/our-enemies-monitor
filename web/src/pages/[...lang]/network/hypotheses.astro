---
import { layoutBoard } from "../../../../../src/site/board-layout.ts";
import { ENTITY_KIND_LABELS, PRIORITY_LABELS } from "../../../../../src/site/format.ts";
import { choose, languageFromParam, languagePaths } from "../../../../../src/site/i18n.ts";
import { hypothesisGraph } from "../../../../../src/site/read-model.ts";
import EvidenceBoard from "../../../islands/EvidenceBoard.tsx";
import "../../../styles/board.css";
import Base from "../../../layouts/Base.astro";
import { assetHref, href } from "../../../lib/links.ts";
import { getModel } from "../../../lib/model.ts";

export const getStaticPaths = () => languagePaths();
const lang = languageFromParam(Astro.params.lang);
const c = (it: string, en: string) => choose(lang, it, en);
const labels = (table: Record<string, { it: string; en: string }>) =>
  Object.fromEntries(Object.entries(table).map(([k, v]) => [k, v[lang]]));
const graph = hypothesisGraph(getModel());
const layout = layoutBoard(graph.nodes, graph.edges, { spacing: 100 });
---

<Base title={c("Bacheca delle ipotesi (esplorativa)", "Hypotheses board (exploratory)")} lang={lang} wide>
  <header class="page-head">
    <p class="kicker kicker-signal">{c("Ipotesi E5 · esplorativo", "Hypotheses E5 · exploratory")}</p>
    <h1>{c("Bacheca delle ipotesi", "Hypotheses board")}</h1>
    <div class="notice">
      {c(
        "Questa bacheca non mostra fatti: ogni filo rosso è una domanda investigativa aperta e non dimostrata (livello E5). Non va letto né citato come una relazione accertata.",
        "This board does not show facts: every red thread is an open, unproven investigative question (level E5). It must not be read or cited as an established relationship.",
      )}{" "}
      <a href={href("network/", lang)}>{c("Bacheca delle evidenze", "Evidence board")}</a>.
    </div>
  </header>
  <EvidenceBoard
    client:only="react"
    lang={lang}
    mode="hypotheses"
    dataUrl={assetHref("data/v1/hypotheses-graph.json")}
    layout={layout}
    entityBase={href("entities/", lang)}
    eventBase={href("events/", lang)}
    groupLabels={{}}
    kindLabels={labels(ENTITY_KIND_LABELS)}
    priorityLabels={labels(PRIORITY_LABELS)}
    sprite={assetHref("icons.svg")}
  />
</Base>

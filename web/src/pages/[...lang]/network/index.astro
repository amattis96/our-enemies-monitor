---
import { layoutBoard } from "../../../../../src/site/board-layout.ts";
import { ENTITY_KIND_LABELS, RELATION_GROUP_LABELS } from "../../../../../src/site/format.ts";
import { choose, languageFromParam, languagePaths, ui } from "../../../../../src/site/i18n.ts";
import { evidenceGraph, isParticipation } from "../../../../../src/site/read-model.ts";
import LimitsNote from "../../../components/LimitsNote.astro";
import EvidenceBoard from "../../../islands/EvidenceBoard.tsx";
import "../../../styles/board.css";
import Base from "../../../layouts/Base.astro";
import { assetHref, href } from "../../../lib/links.ts";
import { getModel } from "../../../lib/model.ts";

export const getStaticPaths = () => languagePaths();
const lang = languageFromParam(Astro.params.lang);
const c = (it: string, en: string) => choose(lang, it, en);
const labels = (table: Record<string, { it: string; en: string }>) =>
  Object.fromEntries(Object.entries(table).map(([key, value]) => [key, value[lang]]));
const model = getModel();
const graph = evidenceGraph(model);
const participation = new Set(model.dataset.relationships.filter(isParticipation).map((r) => r.id));
const layout = layoutBoard(
  graph.nodes,
  graph.edges.map((e) => ({ source: e.source, target: e.target, weak: participation.has(e.id) })),
);
---

<Base title={ui(lang).navNetwork} lang={lang} wide description={c("Bacheca investigativa delle relazioni documentate fra entità ed eventi.", "Investigation board of documented relationships between entities and events.")}>
  <header class="page-head">
    <p class="kicker">{ui(lang).navExplore}</p>
    <h1>{c("Bacheca delle relazioni documentate", "Board of documented relationships")}</h1>
    <p class="lede">
      {c(
        "Ogni scheda è un'entità o un evento; ogni filo è una relazione tipizzata. Il colore del filo indica la famiglia di relazione, il suo tratteggio il livello di evidenza (E1–E4). La partecipazione a eventi è esclusa di default.",
        "Each card is an entity or an event; each thread is a typed relationship. The thread's colour gives the relationship family, its pattern the evidence level (E1–E4). Participation in events is excluded by default.",
      )}
    </p>
    <p class="meta">
      <a href={href("network/hypotheses/", lang)}>{c("Bacheca delle ipotesi (separata)", "Hypotheses board (separate)")}</a>.{" "}
      {c(
        "Le relazioni che riguardano persone senza fonte primaria collegata non sono incluse. I predicati restano nell'italiano originale.",
        "Relationships concerning people without a linked primary source are not included. Predicates remain in the original Italian.",
      )}
    </p>
  </header>
  <EvidenceBoard
    client:only="react"
    lang={lang}
    mode="evidence"
    dataUrl={assetHref("data/v1/graph.json")}
    layout={layout}
    entityBase={href("entities/", lang)}
    eventBase={href("events/", lang)}
    groupLabels={labels(RELATION_GROUP_LABELS)}
    kindLabels={labels(ENTITY_KIND_LABELS)}
    sprite={assetHref("icons.svg")}
  />
  <noscript>
    <p class="notice">{c("La bacheca richiede JavaScript: i dati sono anche nelle schede delle entità e in", "The board requires JavaScript: the data is also on the entity pages and in")} <a href={assetHref("data/v1/graph.json")}>graph.json</a>.</p>
  </noscript>
  <LimitsNote lang={lang} illustration="not-transitive">
    <p>
      {c(
        "La vicinanza sulla bacheca non dimostra coordinamento: A → B e B → C non implicano A → C, e la partecipazione a molti eventi non equivale a dirigerli.",
        "Proximity on the board does not demonstrate coordination: A → B and B → C do not imply A → C, and taking part in many events is not the same as directing them.",
      )}
    </p>
  </LimitsNote>
</Base>

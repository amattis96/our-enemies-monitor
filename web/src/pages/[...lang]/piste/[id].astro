---
import { choose, languageFromParam, languagePaths } from "../../../../../src/site/i18n.ts";
import { type PublicOpenQuestion, projectLaboratory } from "../../../../../src/site/laboratory.ts";
import T from "../../../components/T.astro";
import Base from "../../../layouts/Base.astro";
import { href } from "../../../lib/links.ts";
import { getModel } from "../../../lib/model.ts";
import "../../../styles/lab.css";

export function getStaticPaths() {
  const lab = projectLaboratory(getModel());
  return languagePaths().flatMap((lp) =>
    lab.open_questions.map((lead) => ({
      params: { lang: lp.params.lang, id: lead.id },
      props: { lead },
    })),
  );
}

const lang = languageFromParam(Astro.params.lang);
const c = (it: string, en: string) => choose(lang, it, en);
const { lead } = Astro.props as { lead: PublicOpenQuestion };
---

<Base
  title={`${c("Pista", "Lead")} ${lead.id}`}
  lang={lang}
  wide={true}
  description={c(
    "Pista investigativa pubblica sanitizzata (E5). Le code interne e i riferimenti a persone fisiche sono esclusi.",
    "Sanitized public investigative lead (E5). Internal queues and natural-person references are excluded.",
  )}
>
  <div class="lab-sheet">
    <span class="lab-register-badge">{c("Pista sanitizzata · E5", "Sanitized lead · E5")}</span>
    <h1 class="mt-3">{lead.id}</h1>
    <div class="notice max-w-3xl mt-4">
      {c(
        "Avviso investigativo (E5): questa pista è una domanda di verifica aperta, non un fatto accertato né un'attribuzione.",
        "Investigative notice (E5): this lead is an open verification question, not an established fact or attribution.",
      )}
    </div>

    <article class="lab-card mt-6 max-w-3xl">
      <div class="lab-card-header">
        <span class="lab-code">{lead.id}</span>
        <span class="lab-pill">{lead.priority} · VoI {lead.voi_score}</span>
      </div>
      <p class="mb-0 font-semibold"><T text={lead.question} lang={lang} /></p>
      {lead.current_limit && (
        <p class="meta mb-0">
          <strong>{c("Limite attuale", "Current limit")}:</strong>{" "}
          <T text={lead.current_limit} lang={lang} />
        </p>
      )}
      {lead.evidence_needed && (
        <p class="meta mb-0">
          <strong>{c("Evidenza necessaria", "Evidence needed")}:</strong>{" "}
          <T text={lead.evidence_needed} lang={lang} />
        </p>
      )}
      <p class="meta mb-0">
        <a href={href(`hypotheses/${lead.id}/`, lang)}>{c("Scheda ipotesi canonica", "Canonical hypothesis record")} →</a>{" "}
        · <a href={href("domande/", lang)}>{c("Tutte le domande aperte", "All open questions")}</a>
      </p>
    </article>
  </div>
</Base>

---
import { SOURCE_TYPES } from "../../../../../src/model/index.ts";
import { SOURCE_TYPE_LABELS, formatPartialDate } from "../../../../../src/site/format.ts";
import { archivedResearch } from "../../../../../src/site/research.ts";
import { choose, languageFromParam, languagePaths, ui } from "../../../../../src/site/i18n.ts";
import ArchiveTabs from "../../../components/ArchiveTabs.astro";
import T from "../../../components/T.astro";
import Base from "../../../layouts/Base.astro";
import { href } from "../../../lib/links.ts";
import { getModel } from "../../../lib/model.ts";

export const getStaticPaths = () => languagePaths();
const lang = languageFromParam(Astro.params.lang);
const model = getModel();
const research = archivedResearch();
const groups = SOURCE_TYPES.map((type) => ({
  type,
  sources: model.dataset.sources.filter((s) => s.type === type),
})).filter((g) => g.sources.length > 0);
---

<Base title={ui(lang).navSources} lang={lang}>
  <ArchiveTabs lang={lang} current="sources" counts={{ entities: getModel().dataset.entities.length, hypotheses: getModel().dataset.hypotheses.length, sources: getModel().dataset.sources.length }} />
  <h1>{ui(lang).navSources}</h1>
  <p class="max-w-3xl">
    {choose(
      lang,
      "I codici S00–S08 sono i documenti del corpus del progetto, consolidamenti secondari datati: non sostituiscono la verifica sulla fonte primaria. F e P sono i riferimenti pubblici citati nei registri di Fonte_00 e Fonte_08. Alcune citazioni delle ricerche originali rimandano a sessioni e non a URL permanenti.",
      "Codes S00–S08 are the project's corpus documents, dated secondary consolidations: they do not replace verification against the primary source. F and P are the public references cited in the registers of Fonte_00 and Fonte_08. Some citations in the original research point to research sessions rather than permanent URLs.",
    )}
  </p>
  {
    groups.map((g) => (
      <section>
        <h2>{SOURCE_TYPE_LABELS[g.type][lang]} ({g.sources.length})</h2>
        <ul class="space-y-1">
          {g.sources.map((s) => (
            <li>
              <a class="font-mono" href={href(`sources/${s.id}/`, lang)}>{s.id}</a> <T text={s.title} lang={lang} />
              {s.publisher && <span class="meta"> · {s.publisher}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
  <section class="mt-12" aria-labelledby="recent-source-title">
    <h2 id="recent-source-title">{choose(lang, "Fonti incrementali e dossier tematici", "Incremental sources and thematic dossiers")} ({research.length})</h2>
    <p class="max-w-3xl">
      {choose(
        lang,
        "Questi documenti sono archiviati integralmente in GitHub, ma non equivalgono automaticamente a record canonici convalidati. La cronologia e i grafi pubblicano solo dati che superano i controlli di integrazione.",
        "These documents are archived in full on GitHub, but are not automatically validated canonical records. The timeline and graphs expose only data that passes ingestion and publication controls.",
      )}
    </p>
    <ul class="space-y-3">
      {research.map((source) => (
        <li>
          <span class="meta font-mono">{formatPartialDate(source.createdAt, lang)} · {source.id} · {source.kind === "incremental" ? "OSINT" : choose(lang, "Tematico", "Thematic")}</span>
          <a class="block" href={source.url}>{source.title}</a>
        </li>
      ))}
    </ul>
  </section>
</Base>

---
import { PRIORITY_LABELS } from "../../../../../src/site/format.ts";
import { choose, languageFromParam, languagePaths } from "../../../../../src/site/i18n.ts";
import { projectLaboratory } from "../../../../../src/site/laboratory.ts";
import { projectTechniques, type TechniqueProjection } from "../../../../../src/site/stix.ts";
import T from "../../../components/T.astro";
import Base from "../../../layouts/Base.astro";
import { assetHref, href } from "../../../lib/links.ts";
import { getModel } from "../../../lib/model.ts";
import "../../../styles/lab.css";

export function getStaticPaths() {
  const model = getModel();
  const techniques = projectTechniques(model, projectLaboratory(model));
  return languagePaths().flatMap((lp) =>
    techniques.map((tech) => ({
      params: { lang: lp.params.lang, id: tech.id },
      props: { tech },
    })),
  );
}

const lang = languageFromParam(Astro.params.lang);
const c = (it: string, en: string) => choose(lang, it, en);
const { tech } = Astro.props as { tech: TechniqueProjection };
const events = [...tech.documentedFacts, ...tech.recordedEvents].sort(
  (a, b) => b.date.start.localeCompare(a.date.start) || b.id.localeCompare(a.id),
);
const isCyber = tech.theme === "cyber";
---

<Base
  title={choose(lang, tech.title.it, tech.title.en)}
  lang={lang}
  wide={true}
  description={c(
    "Eventi pubblici del tema e domande aperte (E5), tenuti separati: un evento registrato non è un'attribuzione e una domanda aperta non è un fatto.",
    "Public events in the theme and open questions (E5), kept apart: a recorded event is not an attribution and an open question is not a fact.",
  )}
>
  <div class="lab-sheet">
    <span class="lab-register-badge">{c("Laboratorio · Tema", "Laboratory · Theme")}</span>
    <h1 class="mt-3">{choose(lang, tech.title.it, tech.title.en)}</h1>
    <p class="lede max-w-3xl">
      {c(
        "Questa scheda raccoglie gli eventi pubblici del tema e, separatamente, le domande aperte (E5). Il livello di evidenza è assegnato soprattutto alle relazioni che citano un evento: apri la scheda evento per vederlo.",
        "This sheet gathers the theme's public events and, separately, the open questions (E5). The evidence level is mostly assigned to the relationships citing an event: open the event record to see it.",
      )}
      {isCyber && (
        <>
          {" "}
          <a href={assetHref("data/v1/stix-cyber.json")}>{c("Bundle STIX 2.1 cyber (JSON)", "Cyber STIX 2.1 bundle (JSON)")}</a>.
        </>
      )}
    </p>

    <section class="mt-6">
      <h2>{c("Eventi registrati", "Recorded events")} ({events.length})</h2>
      {events.length === 0 ? (
        <p class="meta mt-2">{c("Nessun evento pubblico in questo tema.", "No public events in this theme.")}</p>
      ) : (
        <div class="lab-cards">
          {events.slice(0, 12).map((ev) => (
            <article class="lab-card">
              <div class="lab-card-header">
                <span class="lab-code">{ev.id}</span>
                <span class="lab-pill">{ev.evidence_level ? `${ev.evidence_level} · ` : ""}{ev.date.start}</span>
              </div>
              <p class="mb-0 font-semibold"><T text={ev.title} lang={lang} /></p>
              <a class="meta" href={href(`events/${ev.id}/`, lang)}>{c("Scheda evento", "Event record")} →</a>
            </article>
          ))}
        </div>
      )}
      {events.length > 12 && (
        <p class="meta mt-3">
          <a href={href("timeline/", lang)}>{c("Tutti gli eventi nella cronologia", "All events in the timeline")} →</a>
        </p>
      )}
    </section>

    <section class="mt-8">
      <h2>{c("Domande aperte (E5)", "Open questions (E5)")}</h2>
      <div class="notice max-w-3xl mt-3">
        {c(
          "Le domande aperte e le ipotesi E5 sono verifiche da fare, mai fatti accertati né attribuzioni.",
          "Open questions and E5 hypotheses are checks still to be made, never established facts or attributions.",
        )}
      </div>
      {tech.investigativeNotices.openHypotheses.length === 0 ? (
        <p class="meta mt-2">{c("Nessuna domanda aperta pubblica in questo tema.", "No public open question in this theme.")}</p>
      ) : (
        <div class="lab-cards">
          {tech.investigativeNotices.openHypotheses.slice(0, 8).map((q) => (
            <article class="lab-card">
              <div class="lab-card-header">
                <span class="lab-code">{q.id}</span>
                <span class="lab-pill">E5 · {c("priorità", "priority")} {PRIORITY_LABELS[q.priority][lang].toLowerCase()}</span>
              </div>
              <p class="mb-0"><T text={q.question} lang={lang} /></p>
              <a class="meta" href={href(`piste/${q.id}/`, lang)}>{c("Scheda della domanda", "Question record")} →</a>
            </article>
          ))}
        </div>
      )}
    </section>
  </div>
</Base>

---
import { THEME_LABELS } from "../../../../src/model/index.ts";
import { languageFromParam, languagePaths, ui } from "../../../../src/site/i18n.ts";
import { timelineItems } from "../../../../src/site/read-model.ts";
import TimelineExplorer from "../../islands/TimelineExplorer.tsx";
import Base from "../../layouts/Base.astro";
import { assetHref, href } from "../../lib/links.ts";
import { getModel } from "../../lib/model.ts";

export const getStaticPaths = () => languagePaths();
const lang = languageFromParam(Astro.params.lang);
const items = timelineItems(getModel(), lang);
const themes = Object.entries(THEME_LABELS).map(([id, label]) => ({ id, label: label[lang] }));
const it = lang === "it";
---

<Base title={ui(lang).navTimeline} lang={lang} wide description={it ? "Cronologia degli eventi documentati, 2007–2026." : "Timeline of documented events, 2007–2026."}>
  <header class="page-head">
    <p class="kicker">{ui(lang).navExplore}</p>
    <h1>{it ? "Cronologia 2026–2007" : "Timeline 2026–2007"}</h1>
    <p class="lede">
      {
        it
          ? "Eventi, decisioni, attribuzioni e sentenze riportati nel corpus, dal più recente al più lontano. Le date note solo al mese o all'anno sono segnate come imprecise e non pretendono una posizione esatta. La data dell'attribuzione o della sentenza è una voce distinta dalla data del fatto."
          : "Events, decisions, attributions and judgments reported in the corpus, from the most recent backwards. Dates known only to the month or year are marked as imprecise and do not claim an exact position. The date of an attribution or judgment is a separate entry from the date of the fact."
      }
    </p>
  </header>
  <TimelineExplorer
    client:load
    lang={lang}
    items={items}
    themes={themes}
    eventBase={href("events/", lang)}
    sprite={assetHref("icons.svg")}
  />
</Base>

<style is:global>
  .tl-filters {
    position: sticky;
    top: 3.75rem;
    z-index: 5;
    display: grid;
    gap: var(--space-3) var(--space-5);
    padding: var(--space-3) 0;
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 760px) {
    .tl-filters {
      grid-template-columns: minmax(12rem, 1.4fr) minmax(10rem, 1fr) auto;
      align-items: end;
    }
    .tl-filters .tl-toggles {
      grid-column: 1 / -1;
      flex-direction: row;
      gap: var(--space-5);
    }
  }
  @media (max-width: 759px) {
    .tl-filters {
      position: static;
    }
  }
  .tl-field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
    border: 0;
    margin: 0;
    padding: 0;
  }
  .tl-field input[type="search"],
  .tl-field select {
    height: 2.5rem;
    padding: 0 0.6rem;
    font-size: var(--text-sm);
  }
  .tl-toggles {
    gap: 0.35rem;
    font-size: var(--text-sm);
    color: var(--ink-2);
  }
  .tl-density {
    margin: var(--space-5) 0 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .tl-bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 4rem;
    border-bottom: 1.5px solid var(--rule-strong);
  }
  .tl-bar {
    flex: 1;
    height: 100%;
    display: flex;
    align-items: flex-end;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .tl-bar span {
    display: block;
    width: 100%;
    background: var(--ink-3);
    opacity: 0.55;
    border-radius: 2px 2px 0 0;
    transition:
      opacity var(--dur-fast) var(--ease-standard),
      background-color var(--dur-fast) var(--ease-standard),
      height var(--dur-base) var(--ease-standard);
  }
  .tl-bar:hover span {
    opacity: 1;
  }
  .tl-bar[aria-pressed="true"] span {
    opacity: 1;
    background: var(--signal);
  }
  .tl-axis {
    display: flex;
    justify-content: space-between;
    margin-top: 0.35rem;
    font-size: var(--text-micro);
    color: var(--ink-3);
  }
  .tl-status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin: var(--space-4) 0;
  }
  .tl-status p {
    margin: 0;
  }
  .tl-empty {
    padding: var(--space-6) 0;
    color: var(--ink-2);
  }
  .tl-spine {
    position: relative;
  }
  .tl-year {
    position: relative;
    display: grid;
    gap: 0 var(--space-5);
  }
  @media (min-width: 760px) {
    .tl-year {
      grid-template-columns: 6rem 1fr;
    }
    .tl-items {
      border-left: 2px solid var(--rule);
      padding-left: var(--space-5);
    }
  }
  .tl-year-label {
    position: sticky;
    top: 9.5rem;
    align-self: start;
    margin: var(--space-4) 0 var(--space-2);
    font-size: var(--text-2xl);
    font-variation-settings: "opsz" 60;
  }
  @media (max-width: 759px) {
    .tl-year-label {
      top: 3.75rem;
      z-index: 2;
      padding: 0.4rem 0;
      background: var(--paper);
      border-bottom: 1px solid var(--rule);
    }
  }
  .tl-year-count {
    display: block;
    font: 500 var(--text-micro) / 1.4 var(--font-mono);
    letter-spacing: var(--tracking-caps);
    color: var(--ink-3);
  }
  .tl-items {
    padding-bottom: var(--space-5);
  }
  .tl-item {
    position: relative;
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--ink);
    transition:
      transform var(--dur-base) var(--ease-standard),
      box-shadow var(--dur-base) var(--ease-standard);
  }
  .tl-item:hover {
    transform: translateX(3px);
    box-shadow: var(--shadow-2);
  }
  @media (min-width: 760px) {
    .tl-item::before {
      content: "";
      position: absolute;
      left: calc(-1 * var(--space-5) - 7px);
      top: 1.1rem;
      width: 10px;
      height: 10px;
      border: 2px solid var(--ink);
      background: var(--paper);
      transform: rotate(45deg);
    }
    .tl-item.is-pending::before {
      border-style: dashed;
    }
  }
  .tl-item.is-pending {
    border-style: dashed;
    background: transparent;
  }
  .tl-item.is-meta {
    border-left-color: var(--ink-3);
    opacity: 0.85;
  }
  .tl-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.75rem;
    align-items: center;
    font-size: var(--text-xs);
    color: var(--ink-3);
  }
  .tl-place {
    font-family: var(--font-sans);
  }
  .tl-fuzzy {
    display: inline-block;
    height: 6px;
    width: 34px;
    background: linear-gradient(90deg, transparent, var(--ink-3) 30%, var(--ink-3) 70%, transparent);
    opacity: 0.6;
  }
  .tl-fuzzy-year {
    width: 56px;
  }
  .tl-title {
    margin: 0.4rem 0 0.35rem;
    font-size: var(--text-lg);
    line-height: 1.25;
  }
  .tl-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .tl-title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--signal);
  }
  .tl-note {
    margin: 0 0 0.5rem;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .tl-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
  }
</style>

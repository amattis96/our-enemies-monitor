---
import { choose, languageFromParam, languagePaths } from "../../../../../src/site/i18n.ts";
import {
  projectVulnerabilities,
  type VulnerabilityDomainProjection,
} from "../../../../../src/site/stix.ts";
import T from "../../../components/T.astro";
import Base from "../../../layouts/Base.astro";
import { href } from "../../../lib/links.ts";
import { getModel } from "../../../lib/model.ts";
import "../../../styles/lab.css";

export function getStaticPaths() {
  const domains = projectVulnerabilities(getModel());
  return languagePaths().flatMap((lp) =>
    domains.map((item) => ({
      params: { lang: lp.params.lang, dominio: item.domain },
      props: { item },
    })),
  );
}

const lang = languageFromParam(Astro.params.lang);
const c = (it: string, en: string) => choose(lang, it, en);
const { item } = Astro.props as { item: VulnerabilityDomainProjection };
---

<Base
  title={choose(lang, item.label.it, item.label.en)}
  lang={lang}
  wide={true}
  description={c(
    "Proiezione pubblica aggregata del dominio di vulnerabilità, priva di dettagli operativi sensibili.",
    "Aggregated public projection of the vulnerability domain, without sensitive operational details.",
  )}
>
  <div class="lab-sheet">
    <span class="lab-register-badge">{c("Laboratorio · Dominio esposto", "Laboratory · Exposed domain")}</span>
    <h1 class="mt-3">{choose(lang, item.label.it, item.label.en)}</h1>
    <div class="notice max-w-3xl mt-4">
      {choose(lang, item.sanitizedNote.it, item.sanitizedNote.en)}
    </div>

    <section class="mt-6 grid gap-4 md:grid-cols-2 max-w-3xl">
      <div class="card">
        <p class="meta">{c("Eventi pubblici nel dominio", "Public events in domain")}</p>
        <p class="text-xl font-mono font-semibold">{item.publicEvents.length}</p>
      </div>
      <div class="card">
        <p class="meta">{c("Esposizioni e dipendenze (tutti i settori)", "Exposures and dependencies (all sectors)")}</p>
        <p class="mb-0"><a href={href("dependencies/", lang)}>{c("Apri la pagina Dipendenze", "Open the Dependencies page")} →</a></p>
      </div>
    </section>

    <section class="mt-8">
      <h2>{c("Eventi pubblici correlati", "Related public events")}</h2>
      {item.publicEvents.length === 0 ? (
        <p class="meta mt-2">{c("Nessun evento pubblico registrato.", "No public events recorded.")}</p>
      ) : (
        <div class="lab-cards">
          {item.publicEvents.slice(0, 12).map((ev) => (
            <article class="lab-card">
              <div class="lab-card-header">
                <span class="lab-code">{ev.id}</span>
                <span class="lab-pill">{ev.evidence_level ? `${ev.evidence_level} · ` : ""}{ev.date.start}</span>
              </div>
              <p class="mb-0 font-semibold"><T text={ev.title} lang={lang} /></p>
              <a class="meta" href={href(`events/${ev.id}/`, lang)}>{c("Scheda evento", "Event record")} →</a>
            </article>
          ))}
        </div>
      )}
    </section>
  </div>
</Base>

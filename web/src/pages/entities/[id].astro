---
import type { Entity } from "../../../../src/model/index.ts";
import {
  ENTITY_KIND_LABELS,
  formatDateRange,
  formatPredicate,
} from "../../../../src/site/format.ts";
import { isParticipation } from "../../../../src/site/read-model.ts";
import EvidenceBadge from "../../components/EvidenceBadge.astro";
import NodeLink from "../../components/NodeLink.astro";
import RecordFooter from "../../components/RecordFooter.astro";
import RelationshipTable from "../../components/RelationshipTable.astro";
import Base from "../../layouts/Base.astro";
import { href } from "../../lib/links.ts";
import { getModel } from "../../lib/model.ts";

export function getStaticPaths() {
  return getModel().dataset.entities.map((entity) => ({
    params: { id: entity.id },
    props: { entity },
  }));
}

const { entity } = Astro.props as { entity: Entity };
const model = getModel();
const relationships = model.relationshipsOf(entity.id);
const direct = relationships.filter((r) => !isParticipation(r));
const participations = relationships
  .filter(isParticipation)
  .map((r) => ({ r, event: model.event(r.subject === entity.id ? r.object : r.subject) }))
  .sort((a, b) => (a.event?.date.start ?? "").localeCompare(b.event?.date.start ?? ""));
const hypotheses = model.hypothesesOf(entity.id);
---

<Base title={entity.name.it} searchable>
  <p class="meta">
    <a href={href("entities/")}>Entità</a> · {ENTITY_KIND_LABELS[entity.kind]} ·{" "}
    <span class="font-mono">{entity.id}</span> · dominio {entity.domain}
  </p>
  <h1>{entity.name.it}</h1>

  {
    entity.kind === "person" && (
      <div class="notice max-w-3xl">
        Persona reale. Ogni relazione indica solo ciò che la fonte citata sostiene, con il proprio
        livello di evidenza. Un'attribuzione istituzionale non è una condanna; la partecipazione a
        un evento non implica responsabilità. Le relazioni prive di fonte primaria collegata restano
        riservate fino alla revisione. Per segnalare correzioni usare il repository GitHub.
      </div>
    )
  }

  <h2>Relazioni dirette ({direct.length})</h2>
  <p class="meta max-w-3xl">
    Ogni predicato va letto letteralmente: «fornisce a» non significa «controlla», «sanziona» non
    significa «condanna».
  </p>
  {
    direct.length > 0 ? (
      <RelationshipTable relationships={direct} caption="Relazioni dirette" />
    ) : (
      <p class="meta">Nessuna relazione diretta registrata.</p>
    )
  }

  <h2>Eventi in cui compare ({participations.length})</h2>
  <p class="meta max-w-3xl">
    Presenza o ruolo nell'evento, non prova di comando, finanziamento o coordinamento.
  </p>
  {
    participations.length > 0 ? (
      <ul class="space-y-1">
        {participations.map(({ r, event }) => (
          <li>
            {event && <span class="meta">{formatDateRange(event.date.start, event.date.end)} · </span>}
            <NodeLink id={r.subject === entity.id ? r.object : r.subject} />
            {model.isRestricted(r) ? (
              <span class="meta"> · ruolo riservato in attesa di fonte primaria</span>
            ) : (
              <span class="meta"> · ruolo: {formatPredicate(r.predicate)}</span>
            )}{" "}
            <EvidenceBadge level={r.evidence_level} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="meta">Nessun evento registrato.</p>
    )
  }

  {
    hypotheses.length > 0 && (
      <>
        <h2>Ipotesi aperte che la riguardano ({hypotheses.length})</h2>
        <p class="meta">Domande investigative non dimostrate: non sono relazioni accertate.</p>
        <ul class="list-disc pl-5">
          {hypotheses.map((h) => (
            <li>
              <a href={href(`hypotheses/${h.id}/`)}>{h.id}</a>: {h.question.it}
            </li>
          ))}
        </ul>
      </>
    )
  }

  <RecordFooter id={entity.id} collection="entities" review={entity.review} provenance={entity.provenance} />
</Base>

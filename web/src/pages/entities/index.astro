---
import { ENTITY_KINDS } from "../../../../src/model/index.ts";
import { ENTITY_KIND_PLURALS } from "../../../../src/site/format.ts";
import Base from "../../layouts/Base.astro";
import { href } from "../../lib/links.ts";
import { getModel } from "../../lib/model.ts";

const model = getModel();
const groups = ENTITY_KINDS.map((kind) => ({
  kind,
  entities: model.dataset.entities
    .filter((e) => e.kind === kind)
    .sort((a, b) => a.name.it.localeCompare(b.name.it, "it")),
}));
---

<Base title="Entità" description="Stati, istituzioni, organizzazioni, imprese, persone e asset del corpus.">
  <h1>Entità</h1>
  <p class="max-w-3xl">
    Il grafo documenta anche alleati, partner commerciali, regolatori e soggetti colpiti: la
    presenza in questo elenco non implica illecito né intento ostile.
  </p>
  <nav aria-label="Tipi di entità" class="meta">
    {groups.map((g) => <a class="mr-3" href={`#${g.kind}`}>{ENTITY_KIND_PLURALS[g.kind]} ({g.entities.length})</a>)}
  </nav>
  {
    groups.map((g) => (
      <section id={g.kind}>
        <h2>{ENTITY_KIND_PLURALS[g.kind]}</h2>
        <ul class="columns-1 sm:columns-2 lg:columns-3">
          {g.entities.map((e) => (
            <li>
              <a href={href(`entities/${e.id}/`)}>{e.name.it}</a>{" "}
              <span class="meta">({model.relationshipsOf(e.id).length})</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

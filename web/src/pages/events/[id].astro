---
import type { Event } from "../../../../src/model/index.ts";
import { formatDateRange, PRECISION_LABELS } from "../../../../src/site/format.ts";
import { isParticipation } from "../../../../src/site/read-model.ts";
import EvidenceBadge from "../../components/EvidenceBadge.astro";
import NodeLink from "../../components/NodeLink.astro";
import RecordFooter from "../../components/RecordFooter.astro";
import RelationshipTable from "../../components/RelationshipTable.astro";
import SourceRefs from "../../components/SourceRefs.astro";
import ThemeList from "../../components/ThemeList.astro";
import Base from "../../layouts/Base.astro";
import { href } from "../../lib/links.ts";
import { getModel } from "../../lib/model.ts";

export function getStaticPaths() {
  return getModel().events.map((event) => ({ params: { id: event.id }, props: { event } }));
}

const { event } = Astro.props as { event: Event };
const model = getModel();
const participants = model.relationshipsOf(event.id).filter(isParticipation);
const citing = model.relationshipsCiting(event.id);
const hypotheses = model.dataset.hypotheses.filter((h) => h.events.includes(event.id));
---

<Base title={event.title.it} description={event.description.it} searchable>
  <p class="meta">
    <a href={href("timeline/")}>Cronologia</a> · <span class="font-mono">{event.id}</span>
  </p>
  <h1>{event.title.it}</h1>
  <p class="meta">
    {formatDateRange(event.date.start, event.date.end)} ({PRECISION_LABELS[event.date.precision]})
    {event.geography && <> · {event.geography.it}</>}
  </p>

  {
    event.timeline_status === "pending_integration" && (
      <div class="notice">
        Evidenza verificata esternamente e non ancora integrata nella cronologia ufficiale (Fonte_06).
      </div>
    )
  }
  {
    event.record_type === "dataset_metadata" && (
      <div class="notice">Questa voce è un metadato del dataset, non un evento geopolitico.</div>
    )
  }
  {
    event.known_issues.map((issue) => (
      <div class="notice">
        <strong>Anomalia nota della baseline:</strong> {issue.note.it} <SourceRefs ids={issue.reported_in} />
      </div>
    ))
  }

  <p class="max-w-3xl text-lg">{event.description.it}</p>

  <dl class="grid gap-x-6 gap-y-2 sm:grid-cols-[max-content_1fr] max-w-3xl">
    {
      event.evidence_note && (
        <>
          <dt class="font-semibold">Valutazione nel corpus</dt>
          <dd>{event.evidence_note.it}</dd>
        </>
      )
    }
    {
      event.evidence_level && (
        <>
          <dt class="font-semibold">Livello di evidenza</dt>
          <dd><EvidenceBadge level={event.evidence_level} /></dd>
        </>
      )
    }
    {
      event.publisher && (
        <>
          <dt class="font-semibold">Fonte pubblica</dt>
          <dd>
            {event.publisher}
            {event.url && <> · <a href={event.url} rel="noopener">documento</a></>}
          </dd>
        </>
      )
    }
    <dt class="font-semibold">Temi</dt>
    <dd><ThemeList themes={event.themes} /></dd>
    {
      event.category && (
        <>
          <dt class="font-semibold">Categoria originale</dt>
          <dd>{event.category.it}</dd>
        </>
      )
    }
    <dt class="font-semibold">Fonti del corpus</dt>
    <dd><SourceRefs ids={event.sources} /></dd>
  </dl>

  <h2>Attori e ruoli nell'evento</h2>
  <p class="meta max-w-3xl">
    Relazioni di presenza o ruolo rispetto all'evento: non indicano di per sé comando,
    finanziamento o coordinamento fra gli attori.
  </p>
  {
    participants.length > 0 ? (
      <RelationshipTable relationships={participants} caption="Attori e ruoli nell'evento" />
    ) : (
      <p class="meta">Nessun attore registrato.</p>
    )
  }

  {
    citing.length > 0 && (
      <>
        <h2>Relazioni dirette che citano l'evento</h2>
        <RelationshipTable relationships={citing} caption="Relazioni dirette che citano l'evento" />
      </>
    )
  }

  {
    hypotheses.length > 0 && (
      <>
        <h2>Ipotesi aperte collegate</h2>
        <ul class="list-disc pl-5">
          {hypotheses.map((h) => (
            <li>
              <a href={href(`hypotheses/${h.id}/`)}>{h.id}</a>: {h.question.it} (<NodeLink id={h.subject} /> →{" "}
              <NodeLink id={h.object} />)
            </li>
          ))}
        </ul>
      </>
    )
  }

  <RecordFooter id={event.id} collection="events" review={event.review} provenance={event.provenance} />
</Base>

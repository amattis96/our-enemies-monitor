---
import { summarize } from "../../../src/pipeline/validate.ts";
import Base from "../layouts/Base.astro";
import { href } from "../lib/links.ts";
import { getModel } from "../lib/model.ts";

const counts = summarize(getModel().dataset);
const sections = [
  [
    "timeline/",
    "Cronologia",
    `${counts.timeline_events} eventi documentati dal 2007 al 2026, filtrabili per tema e periodo.`,
  ],
  [
    "network/",
    "Rete delle relazioni",
    `${counts.direct_relationships} relazioni dirette tipizzate e ${counts.event_participation} partecipazioni a eventi.`,
  ],
  [
    "entities/",
    "Entità",
    `${counts.entities} Stati, istituzioni, organizzazioni, imprese, persone e asset strategici.`,
  ],
  [
    "hypotheses/",
    "Ipotesi aperte",
    `${counts.hypotheses} domande investigative, tenute separate dai fatti documentati.`,
  ],
  ["sources/", "Fonti", `${counts.sources} documenti del corpus e riferimenti esterni citati.`],
  [
    "methodology/",
    "Metodologia",
    "Livelli di evidenza E1–E5, regole di attribuzione e limiti del corpus.",
  ],
];
---

<Base title="Our Enemies Monitor" description="Mappatura basata su evidenze di interferenze straniere, minacce ibride e dipendenze strategiche che riguardano l'Europa." searchable>
  <h1>Our Enemies Monitor</h1>
  <p class="text-lg max-w-3xl">
    Mappatura basata su evidenze di interferenze straniere, minacce ibride, pressioni
    geopolitiche e dipendenze strategiche che riguardano l'Europa.
  </p>
  <div class="notice max-w-3xl">
    <p class="mb-0">
      «Enemies» è il nome del progetto, non una qualifica giuridica o investigativa. La presenza
      nel database non implica illecito, intento ostile, controllo straniero o complicità. Una
      dipendenza commerciale, un disaccordo politico o un collegamento nel grafo non dimostrano
      da soli un'operazione illecita o un coordinamento.
    </p>
  </div>
  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mt-6">
    {
      sections.map(([path, title, text]) => (
        <li class="card">
          <h2 class="mt-0 text-lg">
            <a href={href(path)}>{title}</a>
          </h2>
          <p class="mb-0 meta">{text}</p>
        </li>
      ))
    }
  </ul>
  <p class="meta mt-6">
    Baseline di ricerca con cutoff al 21 ottobre 2026: record curati, non un censimento esaustivo
    degli incidenti in Europa. Tutti i record sono importati dal corpus originale e in attesa di
    revisione editoriale.
  </p>
</Base>

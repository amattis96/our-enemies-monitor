---
import {
  EVIDENCE_LEVEL_LABELS,
  EVIDENCE_LEVELS,
  RELATION_CLASS_GROUP,
  RELATION_GROUPS,
} from "../../../src/model/index.ts";
import { RELATION_GROUP_LABELS } from "../../../src/site/format.ts";
import EvidenceBadge from "../components/EvidenceBadge.astro";
import Base from "../layouts/Base.astro";
import { href } from "../lib/links.ts";

const classesByGroup = RELATION_GROUPS.map((group) => ({
  group,
  classes: Object.entries(RELATION_CLASS_GROUP)
    .filter(([, g]) => g === group)
    .map(([c]) => c),
}));
const rules: [string, string][] = [
  [
    "Connessione non è causalità.",
    "Narrative condivise, vicinanza nel grafo e interessi coincidenti non dimostrano coordinamento operativo.",
  ],
  [
    "Evento, autore, mandante, motivo e impatto sono affermazioni distinte.",
    "Ognuna richiede la propria evidenza.",
  ],
  [
    "L'attribuzione istituzionale non è una sentenza.",
    "Si registra la decisione o la dichiarazione esatta e la sua data.",
  ],
  [
    "Un accertamento può cambiare.",
    "Correzioni, assoluzioni, nuove prove e ritrattazioni restano visibili e versionate.",
  ],
  [
    "Nessuna colpevolezza per associazione.",
    "Gli archi di contesto e partecipazione sono distinti da quelli di controllo e finanziamento.",
  ],
  [
    "Nessuna falsa precisione.",
    "Date, cifre, quote societarie e nessi causali ignoti restano ignoti.",
  ],
  [
    "Le prove contrarie contano.",
    "Si cercano attivamente spiegazioni alternative e risultanze contrarie.",
  ],
];
---

<Base title="Metodologia" description="Livelli di evidenza, regole di attribuzione e limiti del corpus." searchable>
  <h1>Metodologia</h1>
  <p class="max-w-3xl">
    Il progetto è uno strumento di analisi e ricerca, <strong>non un organismo ufficiale</strong> UE,
    NATO, di intelligence, giudiziario o di fact-checking. I livelli di evidenza sono classificazioni
    editoriali, non accertamenti giudiziari né probabilità calibrate.
  </p>

  <h2>Livelli di evidenza</h2>
  <p class="max-w-3xl">
    Il livello descrive il sostegno a una <em>specifica</em> affermazione o relazione, non la
    reputazione complessiva di un'entità. Una condanna è E1 per la condanna, non per tutte le accuse
    esterne citate nella motivazione; una sanzione è E1 per l'atto e può essere E2 per la
    responsabilità attribuita.
  </p>
  <table class="max-w-3xl">
    <thead><tr><th scope="col">Livello</th><th scope="col">Significato</th></tr></thead>
    <tbody>
      {EVIDENCE_LEVELS.map((level) => (
        <tr><td><EvidenceBadge level={level} /></td><td>{EVIDENCE_LEVEL_LABELS[level].it}</td></tr>
      ))}
    </tbody>
  </table>
  <p class="meta max-w-3xl mt-2">
    Il livello E5 non compare mai nella rete delle relazioni: le ipotesi vivono nel{" "}
    <a href={href("hypotheses/")}>registro delle ipotesi</a>.
  </p>

  <h2>Principi</h2>
  <ol class="list-decimal pl-5 max-w-3xl space-y-1">
    {rules.map(([title, text]) => <li><strong>{title}</strong> {text}</li>)}
  </ol>

  <h2>Tipi di relazione</h2>
  <p class="max-w-3xl">
    Ogni relazione conserva la classe e il predicato originali, da leggere letteralmente. I gruppi
    servono solo a filtrare la visualizzazione e non aggiungono affermazioni.
  </p>
  <table class="max-w-3xl">
    <thead><tr><th scope="col">Gruppo</th><th scope="col">Classi originali</th></tr></thead>
    <tbody>
      {classesByGroup.map(({ group, classes }) => (
        <tr><td>{RELATION_GROUP_LABELS[group]}</td><td class="font-mono text-xs">{classes.join(", ")}</td></tr>
      ))}
    </tbody>
  </table>

  <h2>Persone nominate</h2>
  <p class="max-w-3xl">
    Per ogni persona reale devono essere visibili l'atto che la riguarda, la fonte, i limiti, la data
    e lo stato procedurale. Finché una relazione che riguarda una persona non ha una fonte primaria
    collegata, il sito la mostra in forma riservata e la esclude dal grafo. Non si compilano elenchi
    di sospetti sulla base di ideologia, nazionalità o associazioni superficiali.
  </p>

  <h2>Date e cronologia</h2>
  <p class="max-w-3xl">
    Le date hanno una precisione esplicita (anno, mese o giorno). La data di un fatto è distinta da
    quella della sua scoperta, attribuzione, sentenza o pubblicazione: un'attribuzione successiva non
    viene retrodatata all'evento.
  </p>

  <h2>Temi</h2>
  <p class="max-w-3xl">
    I temi della cronologia sono una classificazione editoriale delle categorie originali, che restano
    visibili in ogni scheda come riferimento. Dove il corpus stesso segnala una classificazione
    errata (TL-0035, TL-0048), i temi seguono la correzione indicata.
  </p>

  <h2>Limiti del corpus</h2>
  <ul class="list-disc pl-5 max-w-3xl space-y-1">
    <li>Il corpus è selettivo e curatoriale: non è un censimento di tutti gli incidenti in Europa.</li>
    <li>Le operazioni clandestine non scoperte non sono osservabili; i casi più visibili e occidentali sono sovrarappresentati.</li>
    <li>I conteggi riflettono come è stato costruito il dataset, non la grandezza reale di una minaccia.</li>
    <li>Molte affermazioni non sono ancora state verificate riga per riga sulla fonte primaria.</li>
    <li>Una relazione mancante non prova l'assenza; un'ipotesi non verificata non è un fatto.</li>
  </ul>

  <h2>Correzioni e contributi</h2>
  <p class="max-w-3xl">
    Integrazioni documentate, interpretazioni alternative e correzioni sono benvenute tramite il{" "}
    <a href="https://github.com/amattis96/our-enemies-monitor">repository GitHub</a>, indicando le
    fonti primarie, i record interessati, cosa è noto e cosa è dedotto, e le eventuali prove contrarie.
  </p>
</Base>

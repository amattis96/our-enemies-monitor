---
import { SOURCE_TYPES } from "../../../../src/model/index.ts";
import { SOURCE_TYPE_LABELS } from "../../../../src/site/format.ts";
import Base from "../../layouts/Base.astro";
import { href } from "../../lib/links.ts";
import { getModel } from "../../lib/model.ts";

const model = getModel();
const groups = SOURCE_TYPES.map((type) => ({
  type,
  sources: model.dataset.sources.filter((s) => s.type === type),
})).filter((g) => g.sources.length > 0);
---

<Base title="Fonti" description="Documenti del corpus e riferimenti esterni citati.">
  <h1>Fonti</h1>
  <p class="max-w-3xl">
    I codici <code>S00</code>–<code>S08</code> sono i documenti del corpus del progetto, consolidamenti
    secondari datati: non sostituiscono la verifica sulla fonte primaria. <code>F</code> e{" "}
    <code>P</code> sono i riferimenti pubblici citati nei registri di Fonte_00 e Fonte_08.
    Alcune citazioni delle ricerche originali rimandano a sessioni e non a URL permanenti.
  </p>
  {
    groups.map((g) => (
      <section>
        <h2>{SOURCE_TYPE_LABELS[g.type]} ({g.sources.length})</h2>
        <ul class="space-y-1">
          {g.sources.map((s) => (
            <li>
              <a class="font-mono" href={href(`sources/${s.id}/`)}>{s.id}</a> {s.title.it}
              {s.publisher && <span class="meta"> · {s.publisher}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

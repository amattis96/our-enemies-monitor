---
import { THEME_LABELS } from "../../../src/model/index.ts";
import { timelineItems } from "../../../src/site/read-model.ts";
import TimelineExplorer from "../islands/TimelineExplorer.tsx";
import Base from "../layouts/Base.astro";
import { href } from "../lib/links.ts";
import { getModel } from "../lib/model.ts";

const items = timelineItems(getModel());
const themes = Object.entries(THEME_LABELS).map(([id, label]) => ({ id, label: label.it }));
---

<Base title="Cronologia" description="Cronologia degli eventi documentati, 2007–2026.">
  <h1>Cronologia 2007–2026</h1>
  <p class="max-w-3xl">
    Eventi, decisioni, attribuzioni e sentenze riportati nel corpus. All'interno di ogni anno le
    voci note solo all'anno precedono quelle mensili o giornaliere: è un ordinamento tecnico, non
    un'affermazione sulla sequenza. La data dell'attribuzione o della sentenza è una voce distinta
    dalla data del fatto.
  </p>
  <TimelineExplorer client:load items={items} themes={themes} eventBase={href("events/")} />
  <noscript>
    <ul class="mt-4">
      {items.map((item) => (
        <li><a href={href(`events/${item.id}/`)}>{item.start} — {item.title}</a></li>
      ))}
    </ul>
  </noscript>
</Base>
